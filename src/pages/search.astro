---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout title="Search — Aloha" description="全站搜索。">
  <section class="page-head container">
    <a class="back-home" href="/" data-reveal><span aria-hidden="true">←</span> 返回主页</a>
    <p class="eyebrow" data-reveal style="--reveal-delay: 60ms">/ search</p>
    <h1 data-reveal style="--reveal-delay: 120ms">Search</h1>
    <p data-reveal style="--reveal-delay: 200ms">检索全部 Notes 与 Thinkings 正文。</p>
  </section>

  <section class="search container" aria-label="站内搜索">
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
    <div id="search"></div>
    <noscript><p class="search__status">搜索需要启用 JavaScript。</p></noscript>
    <p class="search__status" id="search-status">正在加载搜索索引…</p>
  </section>
  <SiteFooter />
</BaseLayout>

<script is:inline type="module" data-astro-rerun>
  // 索引与 UI 由构建后的 postbuild 钩子生成在 /pagefind/ 下；
  // astro dev 没有产物索引，这里降级为提示而不是报错。
  // data-astro-rerun: 客户端导航回到本页时重新挂载 Pagefind UI。
  const status = document.getElementById("search-status");
  const mount = document.getElementById("search");
  try {
    const { PagefindUI } = await import("/pagefind/pagefind-ui.js");
    new PagefindUI({
      element: "#search",
      showSubResults: true,
      showImages: false,
      autofocus: true,
      translations: {
        placeholder: "搜索文章内容…",
        clear_search: "清除",
        load_more: "加载更多结果",
        search_label: "站内搜索",
        zero_results: "没有找到「[QUERY]」相关的文章",
        many_results: "共 [COUNT] 条与「[QUERY]」相关",
        one_result: "共 [COUNT] 条与「[QUERY]」相关",
        searching: "正在搜索「[QUERY]」…",
      },
    });
    status?.remove();
  } catch {
    if (status && mount) {
      status.textContent =
        "未找到搜索索引：本地开发请先 npm run build && npm run preview；线上站点应自动可用。";
      mount.remove();
    }
  }
</script>

<style>
  .page-head { padding-top: var(--space-4xl); padding-bottom: var(--space-2xl); }
  .page-head .eyebrow { color: var(--accent); margin-bottom: var(--space-lg); }
  .back-home { display: inline-flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-xl); border: 1px solid var(--border-strong); border-radius: var(--radius-sm); padding: 7px 10px; color: var(--text-muted); font-family: var(--mono); font-size: 12px; transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
  .back-home span { color: var(--accent); }
  .back-home:hover { border-color: var(--accent); color: var(--text); }
  h1 { font-size: clamp(3rem, 6vw, 5.5rem); font-weight: 500; line-height: 1; }
  .page-head > p:last-child { max-width: 54ch; margin-top: var(--space-lg); color: var(--text-muted); }
  .search { max-width: none; min-height: 40vh; padding-top: var(--space-xl); }
  .search__status { color: var(--text-faint); font-family: var(--mono); font-size: 12.5px; margin-top: var(--space-md); }

  /* 让 Pagefind 默认 UI 跟随本站的终端风设计 */
  .search {
    --pagefind-ui-scale: 0.95;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: var(--border-strong);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius-sm);
    --pagefind-ui-image-border-radius: var(--radius-sm);
    --pagefind-ui-font: var(--mono);
  }
</style>
