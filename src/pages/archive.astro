---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { isoDate, safeDate } from "../lib/format";
import { getBlogCollections, momentTitle } from "../lib/content";

// 归档借鉴 WHITE 的栏目逻辑：全站内容按年份分组、可按栏目筛选。
// 标签/分类不在本期范围（不改 PocketBase 数据模型），筛选维度即三个栏目本身。
const { notes, thinkings, moments } = await getBlogCollections();

const buckets = [
  {
    type: "notes",
    label: "笔记",
    entries: notes.map((entry) => ({
      date: entry.data.date,
      title: entry.data.title,
      meta: entry.data.label ?? "",
      href: `/notes/${entry.id}/`,
    })),
  },
  {
    // 小记已并入 Thinkings，归档里同样归入 Thinkings 筛选
    type: "thinkings",
    label: "随想",
    entries: [
      ...thinkings.map((entry) => ({
        date: entry.data.date,
        title: entry.data.title,
        meta: entry.data.label ?? "",
        href: `/thinkings/${entry.id}/`,
      })),
      ...moments.map((entry) => ({
        date: entry.data.date,
        title: momentTitle(entry),
        meta: "小记",
        href: `/thinkings#${entry.id}`,
      })),
    ],
  },
];

const total = buckets.reduce((sum, b) => sum + b.entries.length, 0);

// 已按年分组后，组内行日期只显示「月-日」，年份由组标题承担
const monthDay = (d: Date) => `${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;

// 按年分组（倒序），年内再按日期倒序
const years = new Map<number, Array<{ date: Date; title: string; meta: string; href: string; type: string; typeLabel: string }>>();
for (const bucket of buckets) {
  for (const item of bucket.entries) {
    // content layer 传来的 date 可能是 Date 也可能是 ISO 字符串，统一转 Date
    // —— 取年份和后续排序都依赖它（字符串调 valueOf() 减法会得 NaN，比较器静默失效）
    const date = safeDate(item.date);
    const y = date.getFullYear();
    if (!years.has(y)) years.set(y, []);
    years.get(y).push({ ...item, date, type: bucket.type, typeLabel: bucket.label });
  }
}
const yearGroups = [...years.entries()]
  .sort((a, b) => b[0] - a[0])
  .map(([year, items]) => ({ year, items: items.sort((a, b) => b.date.valueOf() - a.date.valueOf()) }));

const typeCounts = Object.fromEntries(buckets.map((b) => [b.type, b.entries.length])) as Record<string, number>;
const filters = [
  { type: "all", label: "全部", count: total },
  ...buckets.map((b) => ({ type: b.type, label: b.label, count: typeCounts[b.type] })),
];
---

<BaseLayout lang="zh-CN" title="Archive — Aloha" description="Aloha 的全部写作归档，按年份与栏目回溯。">
  <section class="page-head container">
    <h1 data-reveal>归档</h1>
  </section>

  <section class="archive container" aria-label="归档">
    <div class="archive__filters" data-reveal role="group" aria-label="按栏目筛选">
      {
        filters.map((f, i) => (
          <>
            {i > 0 && <span class="archive__filter-sep" aria-hidden="true">/</span>}
            <a
              class="archive__filter"
              href={f.type === "all" ? "/archive/" : `/archive/?type=${f.type}`}
              data-type={f.type}
            >
              {f.label}<span>{f.count}</span>
            </a>
          </>
        ))
      }
    </div>

    {/* 计数已去重：总数由激活筛选项与年份计数承担，顶部总计数行已删（方案 A-3） */}

    <div class="archive__groups">
      {
        yearGroups.map(({ year, items }) => (
          <section class="archive__year" data-year={year}>
            <h2 data-reveal>
              <span data-scramble>{year}</span>
              <span class="archive__year-count">{items.length}</span>
            </h2>
            <ol class="archive__list">
              {items.map((item, index) => (
                <li data-reveal data-type={item.type} style={`--reveal-delay: ${Math.min(index * 40, 300)}ms`}>
                  <a class="archive__row" href={item.href}>
                    <time datetime={isoDate(item.date)}>{monthDay(item.date)}</time>
                    <span class="archive__type">{item.typeLabel}</span>
                    <span class="archive__title">{item.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>
  <SiteFooter />
</BaseLayout>

<script>
  // 栏目筛选：读取 ?type= 参数后隐藏其余条目，URL 保持可分享/可回退。
  function applyFilter() {
    const type = new URLSearchParams(window.location.search).get("type") ?? "all";
    const valid = ["all", "notes", "thinkings"];
    const active = valid.includes(type) ? type : "all";

    document.querySelectorAll(".archive__filter").forEach((el) => {
      el.classList.toggle("is-active", (el as HTMLElement).dataset.type === active);
      // 筛选项是会改变 URL 的链接，用 aria-current 而非 aria-pressed（后者只适用于 toggle button）
      if ((el as HTMLElement).dataset.type === active) el.setAttribute("aria-current", "page");
      else el.removeAttribute("aria-current");
    });

    document.querySelectorAll(".archive__list li").forEach((li) => {
      const match = active === "all" || (li as HTMLElement).dataset.type === active;
      li.toggleAttribute("hidden", !match);
      // 分类标注只在「全部」状态下显示；已筛选的行内不再重复栏目名
      const typeEl = li.querySelector(".archive__type");
      if (typeEl) typeEl.toggleAttribute("hidden", active !== "all");
    });
    document.querySelectorAll(".archive__year").forEach((sec) => {
      const visible = sec.querySelectorAll(".archive__list li:not([hidden])").length;
      sec.toggleAttribute("hidden", visible === 0);
      const count = sec.querySelector(".archive__year-count");
      if (count) count.textContent = String(visible);
    });
  }
  document.addEventListener("astro:page-load", applyFilter);
  applyFilter();
</script>

<style>
  /* .page-head 样式在 global.css 统一维护 */

  /* 斜杠路径式筛选：全部/Notes/Thinkings —— 无框无底色，激活项染琥珀 */
  .archive__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    font-family: var(--mono);
    font-size: 12.5px;
  }
  .archive__filter {
    color: var(--text-muted);
    /* :lang(zh-CN) 直接命中链接元素，mono 必须显式声明而非依赖继承 */
    font-family: var(--mono);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .archive__filter span { margin-left: 4px; color: var(--text-faint); font-size: 11px; }
  .archive__filter:hover { color: var(--text); }
  .archive__filter.is-active { color: var(--accent); }
  .archive__filter.is-active span { color: var(--accent-dim); }
  .archive__filter-sep { color: var(--border-strong); user-select: none; }

  .archive__groups { display: grid; }
  .archive__year h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-md);
    font-size: 28px;
    font-weight: 400;
    font-family: var(--font-body);
    color: var(--text);
  }
  .archive__year-count { color: var(--text-faint); font-size: 13px; }

  .archive__list { margin: 0; padding: 0; list-style: none; }
  .archive__list > li { border-bottom: 1px solid var(--border-subtle); transition: background var(--dur-fast) var(--ease-out); }
  .archive__row {
    display: grid;
    grid-template-columns: 112px auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
  }
  .archive__row time { color: var(--text-faint); font-family: var(--mono); font-size: 12.5px; }
  /* 类型标注：与筛选行同一制式 —— 纯文本无框无底，不占视觉重量 */
  .archive__type {
    justify-self: start;
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 11px;
    white-space: nowrap;
  }
  .archive__title { overflow-wrap: anywhere; font-family: var(--font-body); font-size: 18px; font-weight: 500; line-height: 1.6; transition: color var(--dur-fast) var(--ease-out); }
  @media (hover: hover) {
    .archive__list > li:hover { background: color-mix(in srgb, var(--accent) 4%, transparent); }
    .archive__row:hover .archive__title { color: var(--accent); transform: translateX(3px); }
  }

  @media (max-width: 600px) {
    .page-head { padding-top: var(--space-3xl); }
    .archive__row { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-xs); }
    .archive__row time { grid-column: 1 / -1; }
    .archive__type { justify-self: start; grid-column: 1 / -1; width: fit-content; }
  }
</style>
