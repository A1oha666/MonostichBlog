---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { dotDate, isoDate, DRAFT_PREVIEW } from "../lib/format";
import "@pagefind/default-ui/css/ui.css";

// 归档借鉴 WHITE 的栏目逻辑：全站内容按年份分组、可按栏目筛选。
// 标签/分类不在本期范围（不改 PocketBase 数据模型），筛选维度即三个栏目本身。
const draftFilter = ({ data }) => DRAFT_PREVIEW || !data.draft;

const [notes, thinkings, moments] = await Promise.all([
  getCollection("notes", draftFilter),
  getCollection("thinkings", draftFilter),
  getCollection("moments", draftFilter),
]);

const buckets = [
  {
    type: "notes",
    label: "Notes",
    entries: notes.map((entry) => ({
      date: entry.data.date,
      title: entry.data.title,
      meta: entry.data.label ?? "",
      href: `/notes/${entry.id}/`,
    })),
  },
  {
    // 小记已并入 Thinkings，归档里同样归入 Thinkings 筛选
    type: "thinkings",
    label: "Thinkings",
    entries: [
      ...thinkings.map((entry) => ({
        date: entry.data.date,
        title: entry.data.title,
        meta: entry.data.label ?? "",
        href: `/thinkings/${entry.id}/`,
      })),
      ...moments.map((entry) => ({
        date: entry.data.date,
        // 小记可能没有标题，回退用摘要（loader 侧已用正文摘录兜底）
        title: entry.data.title || entry.data.summary,
        meta: "小记",
        href: `/thinkings#${entry.id}`,
      })),
    ],
  },
];

const total = buckets.reduce((sum, b) => sum + b.entries.length, 0);

// 按年分组（倒序），年内再按日期倒序
const years = new Map<number, Array<{ date: Date; title: string; meta: string; href: string; type: string; typeLabel: string }>>();
for (const bucket of buckets) {
  for (const item of bucket.entries) {
    // content layer 传来的 date 可能是 Date 也可能是 ISO 字符串，统一转 Date
    // —— 取年份和后续排序都依赖它（字符串调 valueOf() 减法会得 NaN，比较器静默失效）
    const date = new Date(item.date);
    const y = date.getFullYear();
    if (!years.has(y)) years.set(y, []);
    years.get(y).push({ ...item, date, type: bucket.type, typeLabel: bucket.label });
  }
}
const yearGroups = [...years.entries()]
  .sort((a, b) => b[0] - a[0])
  .map(([year, items]) => ({ year, items: items.sort((a, b) => b.date.valueOf() - a.date.valueOf()) }));

const typeCounts = Object.fromEntries(buckets.map((b) => [b.type, b.entries.length])) as Record<string, number>;
const filters = [
  { type: "all", label: "全部", count: total },
  ...buckets.map((b) => ({ type: b.type, label: b.label, count: typeCounts[b.type] })),
];
---

<BaseLayout lang="zh-CN" title="Archive — Aloha" description="Aloha 的全部写作归档，按年份与栏目回溯。">
  <section class="page-head container">
    <a class="back-home" href="/" data-reveal><span aria-hidden="true">←</span> 返回主页</a>
    <p class="eyebrow" data-reveal style="--reveal-delay: 60ms">/ archive</p>
  </section>

  <section class="archive container" aria-label="归档">
    <div class="archive__search" data-reveal>
      <div id="archive-search" class="archive-search" role="search"></div>
    </div>

    <div class="archive__filters" data-reveal role="group" aria-label="按栏目筛选">
      {
        filters.map((f, i) => (
          <>
            {i > 0 && <span class="archive__filter-sep" aria-hidden="true">/</span>}
            <a
              class="archive__filter"
              href={f.type === "all" ? "/archive/" : `/archive/?type=${f.type}`}
              data-type={f.type}
            >
              {f.label}<span>{f.count}</span>
            </a>
          </>
        ))
      }
    </div>

    <p class="archive__count" data-reveal data-count><span>{total}</span> 篇内容</p>

    <div class="archive__groups">
      {
        yearGroups.map(({ year, items }) => (
          <section class="archive__year" data-year={year}>
            <h2 data-reveal>
              <span data-scramble>{year}</span>
              <span class="archive__year-count">{items.length}</span>
            </h2>
            <ol class="archive__list">
              {items.map((item, index) => (
                <li data-reveal data-type={item.type} style={`--reveal-delay: ${Math.min(index * 40, 300)}ms`}>
                  <a class="archive__row" href={item.href}>
                    <time datetime={isoDate(item.date)}>{dotDate(item.date)}</time>
                    <span class="archive__type">{item.typeLabel}</span>
                    <span class="archive__title">{item.title}</span>
                    <span class="archive__arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>
  <SiteFooter />
</BaseLayout>

<script>
  // 栏目筛选：读取 ?type= 参数后隐藏其余条目，URL 保持可分享/可回退。
  function applyFilter() {
    const type = new URLSearchParams(window.location.search).get("type") ?? "all";
    const valid = ["all", "notes", "thinkings"];
    const active = valid.includes(type) ? type : "all";

    document.querySelectorAll(".archive__filter").forEach((el) => {
      el.classList.toggle("is-active", (el as HTMLElement).dataset.type === active);
      // 筛选项是会改变 URL 的链接，用 aria-current 而非 aria-pressed（后者只适用于 toggle button）
      if ((el as HTMLElement).dataset.type === active) el.setAttribute("aria-current", "page");
      else el.removeAttribute("aria-current");
    });

    let shown = 0;
    document.querySelectorAll(".archive__list li").forEach((li) => {
      const match = active === "all" || (li as HTMLElement).dataset.type === active;
      li.toggleAttribute("hidden", !match);
      if (match) shown++;
    });
    document.querySelectorAll(".archive__year").forEach((sec) => {
      const visible = sec.querySelectorAll(".archive__list li:not([hidden])").length;
      sec.toggleAttribute("hidden", visible === 0);
      const count = sec.querySelector(".archive__year-count");
      if (count) count.textContent = String(visible);
    });
    const counter = document.querySelector("[data-count] span");
    if (counter) counter.textContent = String(shown);
  }
  document.addEventListener("astro:page-load", applyFilter);
  applyFilter();
</script>

<script>
  import { PagefindUI } from "@pagefind/default-ui";

  // 归档页顶部搜索：官方 UI 开箱即用，挂载到本页容器。
  // PagefindUI 默认从站点根 /pagefind/ 绝对路径加载索引，打包后安全。
  // 客户端脚本按页面打包、视图过渡换页时随 DOM 重建，直接初始化即可。
  function initArchiveSearch() {
    const el = document.getElementById("archive-search");
    if (!el || el.dataset.initialized) return;
    el.dataset.initialized = "true";
    new PagefindUI({
      element: "#archive-search",
      showSubResults: true,
      showImages: false,
      resetStyles: false,
      excerptLength: 26,
      debounceTimeoutMs: 200,
      translations: {
        placeholder: "搜索标题或内容…",
        clear_search: "清除",
        load_more: "加载更多",
        search_label: "站内搜索",
        filters_label: "筛选",
        zero_results: "没有找到「[SEARCH_TERM]」相关内容",
        many_results: "找到 [COUNT] 条「[SEARCH_TERM]」相关结果",
        one_result: "找到 1 条「[SEARCH_TERM]」相关结果",
        alt_search: "没有找到「[SEARCH_TERM]」，试试「[DIFFERENT_TERM]」？",
        search_suggestion: "没有找到「[SEARCH_TERM]」，你可能想找：[DIFFERENT_TERMS]",
        searching: "正在搜索「[SEARCH_TERM]」…",
      },
    });
  }
  document.addEventListener("astro:page-load", initArchiveSearch);
  initArchiveSearch();
</script>

<style>
  /* .page-head / .back-home / .eyebrow 样式在 global.css 统一维护 */

  /* ---- 归档搜索：官方 UI 主题接管 ---- */
  /* 去卡片式搜索框，保留下划线的终端提示行：⌕ ___ ↵ */
  .archive__search { padding-bottom: var(--space-xl); }
  .archive-search {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border-strong);
    --pagefind-ui-tag: var(--surface-2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-font: var(--mono);
    position: relative;
  }
  /* 输入行：无边框卡片，底部一条细线，聚焦时线染琥珀 */
  .archive-search :global(.pagefind-ui__form) {
    border-bottom: 1px solid var(--border-strong);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .archive-search :global(.pagefind-ui__form:focus-within) {
    border-color: var(--accent);
  }
  /* 放大镜图标：官方 form::before 改为琥珀色并重新定位 */
  .archive-search :global(.pagefind-ui__form::before) {
    background-color: var(--accent);
    width: 15px;
    height: 15px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    opacity: 1;
  }
  .archive-search :global(.pagefind-ui__search-input) {
    height: 52px;
    padding: 0 64px 0 28px; /* 左侧留给 ⌕，右侧留给清除 */
    background: transparent;
    border: 0;
    border-radius: 0;
    color: var(--text);
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 400;
    appearance: none;
    -webkit-appearance: none;
  }
  .archive-search :global(.pagefind-ui__search-input:focus) { outline: none; }
  .archive-search :global(.pagefind-ui__search-input::placeholder) { color: var(--text-faint); opacity: 1; }
  /* 清除：一条琥珀斜线 ×，平时 faint，hover 提亮 */
  .archive-search :global(.pagefind-ui__search-clear) {
    top: 0;
    right: 0;
    height: 52px;
    padding: 0 4px;
    background: transparent;
    border-radius: 0;
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 13px;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .archive-search :global(.pagefind-ui__search-clear::before) {
    content: "×";
    margin-right: 4px;
    color: var(--accent-dim);
    font-size: 16px;
    line-height: 1;
    vertical-align: baseline;
  }
  @media (hover: hover) {
    .archive-search :global(.pagefind-ui__search-clear:hover) { color: var(--text); }
    .archive-search :global(.pagefind-ui__search-clear:hover::before) { color: var(--accent); }
  }
  /* 计数/提示语：faint mono，与 archive__count 同制式 */
  .archive-search :global(.pagefind-ui__message) { padding: var(--space-md) 0 var(--space-sm); color: var(--text-faint); font-family: var(--mono); font-size: 12.5px; }
  /* 结果行：去卡片底色，细线分行，hover 微染 */
  .archive-search :global(.pagefind-ui__result) { border-top: 1px solid var(--border-subtle); border-bottom: none; padding: var(--space-md) var(--space-sm); transition: background var(--dur-fast) var(--ease-out); }
  .archive-search :global(.pagefind-ui__result:last-of-type) { border-bottom: 1px solid var(--border-subtle); }
  @media (hover: hover) {
    .archive-search :global(.pagefind-ui__result:hover) { background: color-mix(in srgb, var(--accent) 4%, transparent); }
    .archive-search :global(.pagefind-ui__result-link:hover) { color: var(--accent); }
  }
  .archive-search :global(.pagefind-ui__result-link) { color: var(--text); font-family: var(--serif); font-size: 1.05rem; font-weight: 500; transition: color var(--dur-fast) var(--ease-out); }
  .archive-search :global(.pagefind-ui__result-excerpt) { color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; }
  /* 命中词：琥珀底而非默认黄，暗色下不刺眼 */
  .archive-search :global(.pagefind-ui__result-excerpt mark) { background: var(--accent-soft); color: var(--accent); padding-inline: 1px; }
  /* 子结果锚点：细竖线缩进，mono 小字 */
  .archive-search :global(.pagefind-ui__result-nested) { padding-left: var(--space-md); border-left: 1px solid var(--border); margin-top: var(--space-sm); }
  .archive-search :global(.pagefind-ui__result-nested .pagefind-ui__result-link) { font-size: 0.92rem; font-family: var(--mono); color: var(--text-muted); }
  .archive-search :global(.pagefind-ui__button) { margin-top: var(--space-md); background: transparent; border: 1px solid var(--border-strong); color: var(--text-muted); font-family: var(--mono); font-size: 12.5px; transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
  @media (hover: hover) {
    .archive-search :global(.pagefind-ui__button:hover) { color: var(--accent); border-color: var(--accent-dim); }
  }

  /* 斜杠路径式筛选：全部/Notes/Thinkings —— 无框无底色，激活项染琥珀 */
  .archive__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    font-family: var(--mono);
    font-size: 12.5px;
  }
  .archive__filter {
    color: var(--text-muted);
    /* :lang(zh-CN) 直接命中链接元素，mono 必须显式声明而非依赖继承 */
    font-family: var(--mono);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .archive__filter span { margin-left: 4px; color: var(--text-faint); font-size: 11px; }
  .archive__filter:hover { color: var(--text); }
  .archive__filter.is-active { color: var(--accent); }
  .archive__filter.is-active span { color: var(--accent-dim); }
  .archive__filter-sep { color: var(--border-strong); user-select: none; }

  .archive__count { padding-top: var(--space-xl); padding-bottom: var(--space-md); border-bottom: 1px solid var(--border-strong); color: var(--text-faint); font-family: var(--mono); font-size: 12.5px; }

  .archive__groups { display: grid; }
  .archive__year h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding-top: var(--space-3xl);
    padding-bottom: var(--space-md);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 500;
    font-family: var(--mono);
    color: var(--text);
  }
  .archive__year-count { color: var(--text-faint); font-size: 13px; }

  .archive__list { margin: 0; padding: 0; list-style: none; }
  .archive__list > li { border-bottom: 1px solid var(--border-subtle); transition: background var(--dur-fast) var(--ease-out); }
  .archive__row {
    display: grid;
    grid-template-columns: 112px auto minmax(0, 1fr) 20px;
    align-items: baseline;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
  }
  .archive__row time, .archive__arrow { color: var(--text-faint); font-family: var(--mono); font-size: 12.5px; }
  /* 类型标注：与筛选行同一制式 —— 纯文本无框无底，不占视觉重量 */
  .archive__type {
    justify-self: start;
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 11px;
    white-space: nowrap;
  }
  .archive__title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: clamp(1.02rem, 1.6vw, 1.15rem); font-weight: 500; transition: color var(--dur-fast) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  .archive__arrow { padding-top: 2px; transition: color var(--dur-fast) var(--ease-out), transform var(--dur-base) var(--ease-spring); }
  @media (hover: hover) {
    .archive__list > li:hover { background: color-mix(in srgb, var(--accent) 4%, transparent); }
    .archive__row:hover .archive__title { color: var(--accent); transform: translateX(3px); }
    .archive__row:hover .archive__arrow { color: var(--accent); transform: translate(2px, -2px); }
  }

  @media (max-width: 600px) {
    .page-head { padding-top: var(--space-3xl); }
    .archive__row { grid-template-columns: minmax(0, 1fr) 20px; row-gap: var(--space-xs); }
    .archive__row time { grid-column: 1 / -1; }
    .archive__type { justify-self: start; grid-column: 1 / -1; width: fit-content; }
  }
</style>
