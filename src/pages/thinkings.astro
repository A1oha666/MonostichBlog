---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { dotDate, isoDate, DRAFT_PREVIEW } from "../lib/format";

// Thinkings 吸收原「小记」：两条流按时间倒序混排进同一个栏目。
// thinking 走标题卡（详情页），moment 直接内联正文（无详情页）。
const draftFilter = ({ data }) => DRAFT_PREVIEW || !data.draft;
const [thinkings, moments] = await Promise.all([
  getCollection("thinkings", draftFilter),
  getCollection("moments", draftFilter),
]);

const renderedMoments = await Promise.all(
  moments.map(async (entry) => ({ entry, content: (await render(entry)).Content })),
);

type Item = {
  kind: "thinking" | "moment";
  id: string;
  date: Date;
  title: string;
  label: string;
  summary: string;
  href?: string;
};

const items: Item[] = [
  ...thinkings.map((entry): Item => ({
    kind: "thinking",
    id: entry.id,
    date: new Date(entry.data.date),
    title: entry.data.title,
    label: entry.data.label ?? "",
    summary: entry.data.summary,
    href: `/thinkings/${entry.id}/`,
  })),
  ...renderedMoments.map(({ entry }): Item => ({
    kind: "moment",
    id: entry.id,
    date: new Date(entry.data.date),
    title: entry.data.title,
    label: "小记",
    summary: entry.data.summary,
  })),
];
items.sort((a, b) => b.date.valueOf() - a.date.valueOf());

const momentContents = new Map(renderedMoments.map(({ entry, content }) => [entry.id, content]));
---

<BaseLayout title="Thinkings — Aloha" description="Aloha 的短思考与随手小记。">
  <section class="page-head container">
    <a class="back-home" href="/" data-reveal><span aria-hidden="true">←</span> 返回主页</a>
    <p class="eyebrow" data-reveal style="--reveal-delay: 60ms">/ thinkings</p>
    <h1 data-reveal style="--reveal-delay: 120ms">Thinkings</h1>
    <p data-reveal style="--reveal-delay: 200ms">思绪需要一些出口。</p>
  </section>

  <section class="thinking-list container" aria-label="Thinkings">
    {
      items.map((item, index) => {
        const MomentContent = item.kind === "moment" ? momentContents.get(item.id) : null;
        return (
          <article class="thinking" id={item.id} data-reveal style={`--reveal-delay: ${Math.min(index * 60, 300)}ms`}>
            <div class="thinking__meta">
              {item.kind === "moment" ? <p class="thinking__kind">小记</p> : item.label && <p>{item.label}</p>}
              <time datetime={isoDate(item.date)}>{dotDate(item.date)}</time>
            </div>
            {item.kind === "thinking" ? (
              <div class="thinking__body">
                <span class="thinking__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <h2><a href={item.href}>{item.title}</a></h2>
                <p>{item.summary}</p>
                <a class="thinking__read" href={item.href}>阅读全文 <span aria-hidden="true">→</span></a>
              </div>
            ) : (
              <div class="thinking__body thinking__body--moment">
                <h2 class="thinking__moment-title">{item.title}</h2>
                <div class="thinking__moment-content">{MomentContent && <MomentContent />}</div>
              </div>
            )}
          </article>
        );
      })
    }
  </section>
  <SiteFooter />
</BaseLayout>

<style>
  .page-head { padding-top: var(--space-4xl); padding-bottom: var(--space-2xl); }
  .page-head .eyebrow { color: var(--accent); margin-bottom: var(--space-lg); }
  .back-home { display: inline-flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-xl); border: 1px solid var(--border-strong); border-radius: var(--radius-sm); padding: 7px 10px; color: var(--text-muted); font-family: var(--mono); font-size: 12px; transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
  .back-home span { color: var(--accent); }
  .back-home:hover { border-color: var(--accent); color: var(--text); }
  h1 { font-size: clamp(3rem, 6vw, 5.5rem); font-weight: 400; font-style: italic; line-height: 1; }
  .page-head > p:last-child { max-width: 54ch; margin-top: var(--space-lg); color: var(--text-muted); }
  .thinking-list { border-top: 1px solid var(--border-strong); }
  .thinking { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: var(--space-2xl); padding-block: var(--space-3xl); border-bottom: 1px solid var(--border); transition: background var(--dur-fast) var(--ease-out); scroll-margin-top: calc(var(--nav-height) + var(--space-lg)); }
  @media (hover: hover) {
    .thinking:hover { background: color-mix(in srgb, var(--accent) 3%, transparent); }
  }
  .thinking__meta { padding-top: 7px; font-family: var(--mono); font-size: 12px; }
  .thinking__meta p { color: var(--accent); }
  .thinking__kind { color: var(--text-muted) !important; }
  time { display: block; margin-top: var(--space-sm); color: var(--text-faint); }
  .thinking__body { position: relative; max-width: 720px; }
  .thinking__number { position: absolute; top: 7px; right: 0; color: var(--text-faint); font-family: var(--mono); font-size: 12px; }
  h2 { max-width: 20ch; padding-right: var(--space-2xl); font-size: clamp(1.7rem, 3.5vw, 2.7rem); font-weight: 400; line-height: 1.08; }
  h2 a { transition: color var(--dur-fast) var(--ease-out); }
  .thinking__body > p { max-width: 58ch; margin-top: var(--space-lg); color: var(--text-muted); }
  .thinking__read { display: inline-flex; gap: var(--space-sm); margin-top: var(--space-xl); color: var(--text); font-family: var(--mono); font-size: 12.5px; }
  .thinking__read span { color: var(--accent); transition: transform var(--dur-base) var(--ease-spring); }
  .thinking:hover h2 a { color: var(--accent); }
  .thinking:hover .thinking__read span { transform: translateX(3px); }

  /* 小记：无详情页，标题弱化为条目级、正文直接内联展示 */
  .thinking__moment-title { padding-right: 0; font-size: clamp(1.35rem, 2.5vw, 1.85rem); font-weight: 500; line-height: 1.2; }
  .thinking__moment-content { max-width: 65ch; margin-top: var(--space-md); color: var(--text-muted); }
  .thinking__moment-content :global(> :first-child) { margin-top: 0; }
  .thinking__moment-content :global(p + p) { margin-top: var(--space-md); }
  .thinking__moment-content :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .thinking__moment-content :global(blockquote) { margin: var(--space-md) 0 0; border-left: 2px solid var(--accent); padding-left: var(--space-md); }
  .thinking__moment-content :global(img) { width: 100%; height: auto; margin-top: var(--space-md); border-radius: var(--radius-sm); }

  @media (max-width: 600px) {
    .page-head { padding-top: var(--space-3xl); }
    .thinking { grid-template-columns: 1fr; gap: var(--space-lg); padding-block: var(--space-2xl); }
    .thinking__meta { display: flex; gap: var(--space-md); align-items: center; }
    time { margin: 0; }
  }
</style>
