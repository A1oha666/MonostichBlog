---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { dotDate, isoDate, safeDate } from "../lib/format";
import { getBlogCollections, momentTitle } from "../lib/content";

// 随想 = 长随想（有详情页）+ 小记（一两句话，原文内联直读）。
// 按时间倒序混排；小记不做整块卡片，日期即永久链接。
const { thinkings, moments } = await getBlogCollections();

const renderedMoments = await Promise.all(
  moments.map(async (entry) => {
    const { Content } = await render(entry);
    const hasBody = Boolean(entry.rendered?.html?.trim());
    return { entry, content: hasBody ? Content : null };
  }),
);

type Item = {
  kind: "thinking" | "moment";
  id: string;
  date: Date;
  title: string;
  summary: string;
  href?: string;
};

const items: Item[] = [
  ...thinkings.map((entry): Item => ({
    kind: "thinking",
    id: entry.id,
    date: safeDate(entry.data.date),
    title: entry.data.title,
    summary: entry.data.summary,
    href: `/thinkings/${entry.id}/`,
  })),
  ...renderedMoments.map(({ entry }): Item => ({
    kind: "moment",
    id: entry.id,
    date: safeDate(entry.data.date),
    title: entry.data.title,
    summary: entry.data.summary,
  })),
];
items.sort((a, b) => b.date.valueOf() - a.date.valueOf());

const momentContents = new Map(renderedMoments.map(({ entry, content }) => [entry.id, content]));
---

<BaseLayout lang="zh-CN" title="随想 — Aloha" description="Aloha 的短思考与随手小记。">
  <section class="page-head container">
    <h1>随想<span class="page-head__count">{items.length} 条</span></h1>
    <p>思绪需要一些出口。</p>
  </section>

  <section class="thinking-list container" aria-label="随想列表">
    {
      items.map((item) => {
        const MomentContent = item.kind === "moment" ? momentContents.get(item.id) : null;
        return item.kind === "thinking" ? (
          /* 长随想：标题、摘要与明确的「阅读全文」入口 */
          <article class="thinking thinking--long" id={item.id}>
            <div class="thinking__side">
              <time datetime={isoDate(item.date)}>{dotDate(item.date)}</time>
            </div>
            <div class="thinking__body">
              <h2><a href={item.href}>{item.title}</a></h2>
              {item.summary && <p class="thinking__summary">{item.summary}</p>}
              <a class="thinking__more" href={item.href}>阅读全文 →</a>
            </div>
          </article>
        ) : (
          /* 小记：无标题的直接展示正文；日期即永久链接 */
          <article class="thinking thinking--moment" id={item.id}>
            <div class="thinking__side">
              <a class="thinking__date" href={`/thinkings#${item.id}`} data-permalink aria-label="复制本条小记链接">
                <time datetime={isoDate(item.date)}>{dotDate(item.date)}</time>
                <span class="thinking__copied" aria-hidden="true"></span>
              </a>
            </div>
            <div class="thinking__body thinking__body--moment">
              {item.title && <h2 class="thinking__moment-title">{item.title}</h2>}
              <div class="thinking__moment-content prose-zh">
                {MomentContent ? <MomentContent /> : item.summary && <p>{item.summary}</p>}
              </div>
            </div>
          </article>
        );
      })
    }
  </section>
  <SiteFooter />
</BaseLayout>

<script>
  // 小记永久链接：点击复制链接（不跳转）；从首页/搜索带锚点跳来时，
  // 目标条目短暂突出，随后恢复常态。
  function setupMoments() {
    if (location.hash) {
      let id = location.hash.slice(1);
      try { id = decodeURIComponent(id); } catch {}
      const target = document.getElementById(id);
      if (target && !target.dataset.flashBound) {
        target.dataset.flashBound = "1";
        target.classList.add("is-flash");
        setTimeout(() => target.classList.remove("is-flash"), 2200);
      }
    }
    document.querySelectorAll<HTMLAnchorElement>("[data-permalink]").forEach((a) => {
      if (a.dataset.bound) return;
      a.dataset.bound = "1";
      a.addEventListener("click", async (event) => {
        event.preventDefault();
        const url = `${location.origin}/thinkings#${a.closest("article")?.id ?? ""}`;
        let done = false;
        try {
          await navigator.clipboard.writeText(url);
          done = true;
        } catch {}
        const tip = a.querySelector(".thinking__copied");
        if (tip) {
          tip.textContent = done ? "已复制链接" : "复制失败";
          tip.classList.add("is-visible");
          setTimeout(() => tip.classList.remove("is-visible"), 1400);
        }
      });
    });
  }
  document.addEventListener("astro:page-load", setupMoments);
  setupMoments();
</script>

<style>
  /* .page-head 样式在 global.css 统一维护；page-head__count 为页面级补充 */
  .page-head__count { margin-left: 10px; color: var(--text-faint); font-family: var(--mono); font-size: 13px; font-weight: 400; }
  .thinking-list { border-top: 1px solid var(--border-strong); }
  .thinking {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--space-lg);
    border-bottom: 1px solid var(--border-subtle);
    scroll-margin-top: calc(var(--nav-height) + var(--space-lg));
  }
  /* 小记按真实内容比例：上下 24–32px，不套用长文章的展示高度 */
  .thinking--moment { padding-block: 26px; }
  .thinking--long { padding-block: var(--space-2xl); }
  .thinking__side { padding-top: 5px; font-family: var(--mono); font-size: 12.5px; }
  .thinking__side time { color: var(--text-faint); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .thinking__date { position: relative; display: inline-flex; align-items: baseline; gap: 8px; transition: color var(--dur-fast) var(--ease-out); }
  .thinking__date:hover { color: var(--accent); }
  .thinking__date:hover time { color: var(--accent); }
  .thinking__copied {
    position: absolute;
    left: 0;
    top: calc(100% + 4px);
    color: var(--accent);
    font-size: 11px;
    white-space: nowrap;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .thinking__copied.is-visible { opacity: 1; }

  .thinking__body { min-width: 0; max-width: 720px; }
  h2 { font-family: var(--font-body); font-size: 24px; font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
  h2 a { display: inline-block; text-decoration: underline; text-decoration-color: var(--border-strong); text-underline-offset: 6px; text-decoration-thickness: 1px; transition: color var(--dur-fast) var(--ease-out), text-decoration-color var(--dur-fast) var(--ease-out); }
  @media (hover: hover) {
    h2 a:hover { color: var(--accent); text-decoration-color: var(--accent); }
  }
  h2 a:focus-visible { color: var(--accent); text-decoration-color: var(--accent); outline: 1px solid var(--accent); outline-offset: 4px; }
  .thinking__summary { max-width: 60ch; margin-top: var(--space-md); color: var(--text-muted); font-size: 16px; line-height: 1.8; }
  .thinking__more { display: inline-block; margin-top: var(--space-md); color: var(--accent); font-size: 14.5px; transition: color var(--dur-fast) var(--ease-out); }
  .thinking__more:hover { color: var(--accent-deep); }

  /* 小记正文：原文直读，文字区域保持可选择 */
  .thinking__moment-title { font-size: 19px; font-weight: 600; line-height: 1.45; }
  .thinking__moment-content { max-width: 65ch; color: var(--text); font-size: 16.5px; }
  .thinking__moment-title + .thinking__moment-content { margin-top: var(--space-sm); }
  .thinking__moment-content :global(> :first-child) { margin-top: 0; }
  .thinking__moment-content :global(p + p) { margin-top: var(--space-sm); }
  .thinking__moment-content :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .thinking__moment-content :global(blockquote) { margin: var(--space-sm) 0 0; border-left: 2px solid var(--accent); padding-left: var(--space-md); color: var(--text-muted); }
  .thinking__moment-content :global(img) { width: 100%; height: auto; margin-top: var(--space-md); border-radius: var(--radius-sm); }

  /* 锚点跳入的短暂突出：行底淡染，2.2s 后由脚本移除 */
  .thinking.is-flash { background: var(--accent-soft); transition: background 600ms var(--ease-out); }

  @media (max-width: 600px) {
    .thinking { grid-template-columns: 1fr; gap: 4px; }
    .thinking__side { padding-top: 0; }
  }
</style>
