---
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import DarkHome from '../components/DarkHome.astro';
import Projects from '../components/Projects.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeExcerpt from '../components/HomeExcerpt.astro';
import { dotDate, isoDate, safeDate } from '../lib/format';
import { getBlogCollections, momentTitle } from '../lib/content';
import { lab } from '../data/lab.js';
import { projects } from '../data/projects.js';

const { notes, thinkings, moments } = await getBlogCollections();
const latestMoment = [...moments].sort((a, b) => safeDate(b.data.date).valueOf() - safeDate(a.data.date).valueOf()).find((entry) => momentTitle(entry));
const allEntries = [...notes, ...thinkings, ...moments];
const latestDate = allEntries.map((entry) => safeDate(entry.data.date)).sort((a, b) => b.valueOf() - a.valueOf())[0];
const recent = [
  ...notes.map((entry) => ({ date: entry.data.date, title: entry.data.title, summary: entry.data.summary, category: '笔记', href: `/notes/${entry.id}/` })),
  ...thinkings.map((entry) => ({ date: entry.data.date, title: entry.data.title, summary: entry.data.summary, category: '随想', href: `/thinkings/${entry.id}/` })),
  ...moments.filter((entry) => entry.id !== latestMoment?.id).map((entry) => ({ date: entry.data.date, title: momentTitle(entry), summary: '', category: '小记', href: `/thinkings#${entry.id}` })),
].sort((a, b) => safeDate(b.date).valueOf() - safeDate(a.date).valueOf()).slice(0, 3);
---

<BaseLayout lang="zh-CN" bodyClass="home">
  <div class="theme-home theme-home--light">
  <Hero notesCount={allEntries.length} projectsCount={projects.length} latestDate={latestDate} />
  <section class="section container recent" id="recent" aria-labelledby="home-recent-heading">
    <div class="module-head">
      <h2 id="home-recent-heading" data-scramble>文章</h2>
      <a href="/archive" aria-label="全部文章">全部 →</a>
    </div>
    <ol class="recent-list">
      {recent.map((item, index) => (
        <li data-reveal style={`--reveal-delay: ${Math.min(index * 50, 150)}ms`}>
          <a class="recent-row" href={item.href}>
            <div class="recent-row__body">
              <h3>{item.title}</h3>
              {item.summary && <p class="recent-row__summary">{item.summary}</p>}
            </div>
            <time datetime={isoDate(item.date)}>{dotDate(item.date)}</time>
            <ArrowUpRight class="recent-row__arrow" size={18} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ol>
    {recent.length === 0 && <p class="recent__empty">文章正在酝酿中。</p>}
  </section>

  {latestMoment && (
    <section class="oneline" aria-labelledby="home-oneline-heading">
      <div class="container">
        <div class="module-head">
          <h2 id="home-oneline-heading" data-scramble>随想</h2>
          <a href="/thinkings" aria-label="全部随想">全部 →</a>
        </div>
        <figure data-reveal>
          <blockquote><a href={`/thinkings#${latestMoment.id}`}>{momentTitle(latestMoment)}</a></blockquote>
          <figcaption><time datetime={isoDate(latestMoment.data.date)}>{dotDate(latestMoment.data.date)}</time></figcaption>
        </figure>
      </div>
    </section>
  )}

  <Projects />
  <section class="section container" aria-labelledby="home-lab-heading">
    <div class="module-head" data-reveal>
      <h2 id="home-lab-heading" data-scramble>实验室</h2>
      <a href="/lab/" aria-label="全部实验">全部 →</a>
    </div>
    <ol class="lab-list">
      {lab.slice(0, 1).map((item) => (
        <li data-reveal><a href={item.href}><div><h3>{item.name}</h3><p>{item.desc}</p></div><ArrowUpRight size={18} aria-hidden="true" /></a></li>
      ))}
    </ol>
  </section>
  </div>
  <DarkHome collections={{ notes, thinkings, moments }} />
  <SiteFooter><HomeExcerpt /></SiteFooter>
</BaseLayout>

<style>
  .recent { padding-top: 32px; }
  .recent .module-head h2 { font-size: 24px; }
  .recent-list, .lab-list { list-style: none; padding: 0; margin: 0 auto; max-width: 704px; text-align: center; }
  .recent-list li, .lab-list li { border-top: 1px solid var(--border); }
  .recent-row { position: relative; display: flex; flex-direction: column; gap: 14px; align-items: center; padding-block: 32px; }
  .recent-row__body { width: 100%; }
  .recent-row :global(.recent-row__arrow) { display: none; }
  .recent-row::before { content: ''; position: absolute; inset: 4px -16px; background: var(--surface-2); opacity: 0; z-index: -1; transition: opacity 220ms ease; border-radius: 6px; }
  .recent-row { isolation: isolate; }
  @media (hover: hover) { .recent-row:hover::before { opacity: 1; } }
  .recent-row__category { color: var(--text-muted); font-size: 12px; margin-bottom: 8px; }
  .recent-row h3 { font-size: 23px; line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; transition: color 220ms ease; }
  .recent-row__summary { max-width: 60ch; margin: 10px auto 0; color: var(--text-muted); font-size: 15px; line-height: 1.75; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  time { color: var(--text-muted); font-size: 13px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .recent-row :global(svg), .lab-list :global(svg) { color: var(--text-faint); }
  .recent-row :global(svg), .lab-list :global(svg) { transition: transform 250ms var(--ease-out), color 250ms ease; }
  .recent-row:hover :global(svg), .lab-list a:hover :global(svg) { transform: translate(2px, -2px); color: var(--accent); }
  .recent-row:hover h3, .lab-list a:hover h3 { color: var(--accent); }
  .recent__empty { color: var(--text-muted); padding-block: 32px; }
  .oneline { background: var(--surface-2); padding-block: 56px; }
  .oneline h2 { font-size: 17px; color: var(--text-muted); }
  figure { margin: 0; text-align: center; }
  blockquote { max-width: 36ch; margin: 32px auto; font-size: 36px; font-weight: 500; line-height: 1.6; overflow-wrap: anywhere; }
  figcaption { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 24px; }
  figcaption a { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-size: 14px; min-height: 44px; }
  .lab-list a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding-block: 28px; }
  .lab-list h3 { font-size: 20px; font-weight: 500; line-height: 1.5; }
  .lab-list p { color: var(--text-muted); font-size: 15px; margin-top: 6px; }
  @media (max-width: 640px) {
    .recent { padding-top: 32px; }
    .recent .module-head h2 { font-size: 20px; }
    .recent-row { gap: 12px; padding-block: 28px; }
    .recent-row__body { grid-column: 1 / -1; }
    .recent-row h3 { font-size: 20px; }
    .recent-row time { grid-column: 1; }
    blockquote { font-size: 23px; }
    .oneline { padding-block: 36px; }
  }
</style>
