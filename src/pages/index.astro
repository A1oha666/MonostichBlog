---
import BaseLayout from '../layouts/BaseLayout.astro';
import DarkHome from '../components/dark/DarkHome.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeExcerpt from '../components/HomeExcerpt.astro';
import { dotDate, isoDate, safeDate } from '../lib/format';
import { getBlogCollections, momentTitle } from '../lib/content';
import { lab } from '../data/lab.js';

// 主题在客户端决定：两套分支都由服务端输出，浅色分支用 CSS 隐藏深色分支。
// 两分支都是合法 HTML，JS 不可用时按浅色呈现（渐进增强）。
const { notes, thinkings, moments } = await getBlogCollections();

// 首页展示最近五条：笔记、长随想与小记统一混排，完整回溯走 /archive。
const recentSorted = [
  ...notes.map((entry) => ({ key: `notes/${entry.id}`, date: safeDate(entry.data.date), title: entry.data.title, summary: entry.data.summary, category: '笔记', href: `/notes/${entry.id}/` })),
  ...thinkings.map((entry) => ({ key: `thinkings/${entry.id}`, date: safeDate(entry.data.date), title: entry.data.title, summary: entry.data.summary, category: '随想', href: `/thinkings/${entry.id}/` })),
  ...moments.map((entry) => ({ key: `moments/${entry.id}`, date: safeDate(entry.data.date), title: momentTitle(entry), summary: '', category: '小记', href: `/thinkings#${entry.id}` })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const recentAll = recentSorted.slice(0, 5);
---

<BaseLayout lang="zh-CN" bodyClass="home">
  {/* ============ 深色分支：信号核控制台（浅色下 display:none） ============ */}
  <div class="dark-home">
    <DarkHome recent={recentAll} />
  </div>

  {/* ============ 浅色分支：原始 Apple 风首页（一字未动） ============ */}
  <div class="light-home">
    <Hero />

    <section class="section container recent" id="recent" aria-labelledby="home-recent-heading">
      <div class="module-head" data-reveal>
        <h2 id="home-recent-heading" data-scramble data-no="01">最近更新</h2>
        <a href="/archive" aria-label="全部内容">全部 →</a>
      </div>
      <ol class="recent-list" lang="zh-CN">
        {recentAll.map((item, index) => (
          <li data-reveal style={`--reveal-delay: ${Math.min(index * 60, 240)}ms`}>
            <a class="recent-row" href={item.href}>
              <span class="recent-list__no" aria-hidden="true">{index + 1}</span>
              <span class="recent-row__body">
                <h3>{item.title}</h3>
                {item.summary && <p class="recent-row__summary">{item.summary}</p>}
              </span>
              <time datetime={isoDate(item.date)}>{dotDate(item.date)}</time>
            </a>
          </li>
        ))}
      </ol>
      {recentAll.length === 0 && <p class="recent__empty">内容正在酝酿中。</p>}
    </section>

    <Projects />

    <section class="section container lab" aria-labelledby="home-lab-heading">
      <div class="module-head" data-reveal>
            <h2 id="home-lab-heading" data-scramble data-no="04">实验室</h2>
        <a href="/lab/" aria-label="全部实验">全部 →</a>
      </div>
      <ol class="recent-list" lang="zh-CN">
        {lab.map((item, index) => (
          <li data-reveal style={`--reveal-delay: ${Math.min(index * 60, 120)}ms`}>
            <a class="recent-row" href={item.href}>
              <span class="recent-list__no" aria-hidden="true">{index + 1}</span>
              <span class="recent-row__body">
                <h3>{item.name}</h3>
                <p class="recent-row__summary">{item.desc}</p>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <SiteFooter><HomeExcerpt /></SiteFooter>
  </div>
</BaseLayout>

<style>
  /* =========================================================
     主题分流：两分支互斥显示
     ========================================================= */
  :root:not([data-theme='dark']) .dark-home { display: none; }
  :root[data-theme='dark'] .light-home { display: none; }

  /* =========================================================
     以下为浅色分支的全部样式（深色分支组件自带样式，此处不再接管）
     ========================================================= */

  .recent-list__no { display: none; }

  /* ---------- 共享 ---------- */
  .recent-list { list-style: none; padding: 0; margin: 0; }
  .recent__empty { color: var(--text-muted); padding-block: 32px; }
  time { color: var(--text-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* ---------- 浅色：居中卡片式 ---------- */
  :root:not([data-theme='dark']) {
    /* 浅色为纯编辑排版：终端式编号 // 01 仅深色显示 */
    .module-head__no { display: none; }
    .recent, .lab { text-align: initial; }
    .recent .module-head h2, .lab .module-head h2 { font-size: 24px; }
    .recent .recent-list { width: 100%; max-width: none; }
    .lab .recent-list { max-width: 704px; margin: 0 auto; }
    .recent-list li { border-top: 1px solid var(--border); }
    /* 目录制式：日期在左 112px 侧栏、标题左对齐为扫描起点 —— 与 Notes 页同构 */
    .recent-row { position: relative; display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: var(--space-lg); align-items: baseline; padding-block: 28px; isolation: isolate; }
    .recent-row time { grid-column: 1; font-size: 12.5px; font-family: var(--mono); color: var(--text-faint); }
    .recent-row__body { grid-column: 2; min-width: 0; }
    .recent-row h3 { font-size: 20px; line-height: 1.45; font-weight: 600; overflow-wrap: anywhere; transition: color var(--dur-fast) var(--ease-out); }
    .recent-row__summary { max-width: 60ch; margin: 8px 0 0; color: var(--text-muted); font-size: 15px; line-height: 1.75; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .recent-row:hover h3 { color: var(--accent); }
  }

  @media (max-width: 640px) {
    :root:not([data-theme='dark']) {
      .recent .module-head h2, .lab .module-head h2 { font-size: 20px; }
      /* 移动端简单适配：日期退到标题上方，单列堆叠。
         grid-row 只限定含 time 的文章行 —— lab 行没有 time，强制 row:2 会
         留出一个 0 高首行 + gap 的空隙 */
      .recent .recent-row, .lab .recent-row { grid-template-columns: 1fr; gap: 6px; padding-block: 24px; }
      .recent-row time { grid-column: 1 / -1; grid-row: 1; }
      .recent .recent-row__body { grid-column: 1 / -1; grid-row: 2; }
      .lab .recent-row__body { grid-column: 1 / -1; grid-row: 1; }
      .recent-row h3 { font-size: 18px; }
    }
  }
</style>
