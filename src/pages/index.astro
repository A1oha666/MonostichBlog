---
import BaseLayout from '../layouts/BaseLayout.astro';
import DarkHome from '../components/dark/DarkHome.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeExcerpt from '../components/HomeExcerpt.astro';
import { dotDate, isoDate, safeDate } from '../lib/format';
import { getBlogCollections, momentTitle } from '../lib/content';
import { lab } from '../data/lab.js';
import { projects } from '../data/projects.js';

// 主题在客户端决定：两套分支都由服务端输出，浅色分支用 CSS 隐藏深色分支。
// 两分支都是合法 HTML，JS 不可用时按浅色呈现（渐进增强）。
const { notes, thinkings, moments } = await getBlogCollections();

// 「一行」：最新一条小记，作为本站点题的单行诗
const latestMoment = [...moments]
  .map((entry) => ({ id: entry.id, date: safeDate(entry.data.date), text: momentTitle(entry) }))
  .filter((m) => m.text)
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())[0];

const allEntries = [...notes, ...thinkings, ...moments];
const latestDate = allEntries.map((entry) => safeDate(entry.data.date)).sort((a, b) => b.valueOf() - a.valueOf())[0];

// 首页展示最近五篇（Notes 与 Thinkings 含小记混排），完整回溯走 /archive。
// 已被「一行」引用的小记从目录里剔除，避免相邻两节重复同一条内容。
const recent = [
  ...notes.map((entry) => ({ key: `notes/${entry.id}`, date: safeDate(entry.data.date), title: entry.data.title, summary: entry.data.summary, category: '笔记', href: `/notes/${entry.id}/` })),
  ...thinkings.map((entry) => ({ key: `thinkings/${entry.id}`, date: safeDate(entry.data.date), title: entry.data.title, summary: entry.data.summary, category: '随想', href: `/thinkings/${entry.id}/` })),
  ...moments.map((entry) => ({ key: `moments/${entry.id}`, date: safeDate(entry.data.date), title: momentTitle(entry), summary: '', category: '小记', href: `/thinkings#${entry.id}` })),
]
  .filter((item) => item.key !== `moments/${latestMoment?.id}`)
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 5);

// Hero 状态面板与日志瀑布：真实统计 + 真实 slug 路径池
const notesCount = allEntries.length;
const projectsCount = projects.length;
const logPaths = [
  { p: "/", w: 10 },
  ...notes.map((entry) => ({ p: `/notes/${entry.id}`, w: 6 })),
  ...thinkings.map((entry) => ({ p: `/thinkings/${entry.id}`, w: 5 })),
  { p: "/notes", w: 3 },
  { p: "/thinkings", w: 3 },
  { p: "/archive", w: 2 },
  { p: "/about", w: 2 },
  { p: "/rss.xml", w: 1.5 },
];

// 深色分支派生数据：MM.DD 更新标签与站点运行天数
const pad2 = (n: number) => String(n).padStart(2, '0');
const updatedLabel = latestDate
  ? `${pad2(latestDate.getMonth() + 1)}.${pad2(latestDate.getDate())}`
  : '—';
const uptimeDays = Math.max(1, Math.floor((Date.now() - new Date('2026-08-25T00:00:00Z').valueOf()) / 86400000));
---

<BaseLayout lang="zh-CN" bodyClass="home">
  {/* ============ 深色分支：信号核控制台（浅色下 display:none） ============ */}
  <div class="dark-home">
    <DarkHome
      recent={recent}
      latestMoment={latestMoment}
      notesCount={notesCount}
      projectsCount={projectsCount}
      updatedLabel={updatedLabel}
      uptimeDays={uptimeDays}
    />
  </div>

  {/* ============ 浅色分支：原始 Apple 风首页（一字未动） ============ */}
  <div class="light-home">
    <Hero notesCount={notesCount} projectsCount={projectsCount} latestDate={latestDate} logPaths={logPaths} />

    {latestMoment && (
      <section class="oneline" aria-labelledby="home-oneline-heading">
        <div class="container">
          <div class="module-head" data-reveal>
            <h2 id="home-oneline-heading" data-scramble data-no="01">随想</h2>
            <a href="/thinkings">小记 →</a>
          </div>
          <figure class="oneline__figure" data-reveal style="--reveal-delay: 80ms">
            <blockquote lang="zh-CN"><a href={`/thinkings#${latestMoment.id}`}>{latestMoment.text}</a></blockquote>
            <figcaption><time datetime={isoDate(latestMoment.date)}>{dotDate(latestMoment.date)}</time></figcaption>
          </figure>
        </div>
      </section>
    )}

    <section class="section container recent" id="recent" aria-labelledby="home-recent-heading">
      <div class="module-head" data-reveal>
            <h2 id="home-recent-heading" data-scramble data-no="02">文章</h2>
        <a href="/archive" aria-label="全部文章">全部 →</a>
      </div>
      <ol class="recent-list" lang="zh-CN">
        {recent.map((item, index) => (
          <li data-reveal style={`--reveal-delay: ${Math.min(index * 60, 240)}ms`}>
            <a class="recent-row" href={item.href}>
              <span class="recent-list__no" aria-hidden="true">{index + 1}</span>
              <span class="recent-row__body">
                <h3>{item.title}</h3>
                {item.summary && <p class="recent-row__summary">{item.summary}</p>}
              </span>
              <span class="recent-list__desc" aria-hidden="true">{item.summary}</span>
              <time datetime={isoDate(item.date)}>{dotDate(item.date)}</time>
            </a>
          </li>
        ))}
      </ol>
      {recent.length === 0 && <p class="recent__empty">文章正在酝酿中。</p>}
    </section>

    <Projects />

    <section class="section container lab" aria-labelledby="home-lab-heading">
      <div class="module-head" data-reveal>
            <h2 id="home-lab-heading" data-scramble data-no="04">实验室</h2>
        <a href="/lab/" aria-label="全部实验">全部 →</a>
      </div>
      <ol class="recent-list" lang="zh-CN">
        {lab.map((item, index) => (
          <li data-reveal style={`--reveal-delay: ${Math.min(index * 60, 120)}ms`}>
            <a class="recent-row" href={item.href}>
              <span class="recent-list__no" aria-hidden="true">{index + 1}</span>
              <span class="recent-row__body">
                <h3>{item.name}</h3>
                <p class="recent-row__summary">{item.desc}</p>
              </span>
              <span class="recent-list__desc">{item.desc}</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <SiteFooter><HomeExcerpt /></SiteFooter>
  </div>
</BaseLayout>

<style>
  /* =========================================================
     主题分流：两分支互斥显示
     ========================================================= */
  :root:not([data-theme='dark']) .dark-home { display: none; }
  :root[data-theme='dark'] .light-home { display: none; }

  /* =========================================================
     以下为浅色分支的全部样式（深色分支组件自带样式，此处不再接管）
     ========================================================= */

  .recent-list__no { display: none; }

  /* ---------- 共享 ---------- */
  .recent-list { list-style: none; padding: 0; margin: 0; }
  .recent__empty { color: var(--text-muted); padding-block: 32px; }
  time { color: var(--text-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* ---------- 浅色：居中卡片式 ---------- */
  :root:not([data-theme='dark']) {
    /* 浅色为纯编辑排版：终端式编号 // 01 仅深色显示 */
    .module-head__no { display: none; }
    .oneline { background: var(--surface-2); padding-block: 56px; }
    .oneline .module-head h2 { font-size: 17px; color: var(--text-muted); }
    .oneline__figure { margin: 0; text-align: center; }
    .oneline__figure blockquote { max-width: 36ch; margin: 32px auto; font-size: 36px; font-weight: 500; line-height: 1.6; overflow-wrap: anywhere; }
    .oneline__figure blockquote a { color: inherit; }
    .oneline__figure figcaption { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 24px; }
    .oneline__figure time { font-size: 13px; }

    .recent, .lab { text-align: center; }
    .recent .module-head h2, .lab .module-head h2 { font-size: 24px; }
    .recent-list { max-width: 704px; margin: 0 auto; }
    .recent-list li { border-top: 1px solid var(--border); }
    .recent-row { position: relative; display: flex; flex-direction: column; gap: 14px; align-items: center; padding-block: 32px; isolation: isolate; }
    .recent-row__body { width: 100%; }
    .recent-row::before { content: ''; position: absolute; inset: 4px -16px; background: var(--surface-2); opacity: 0; z-index: -1; transition: opacity 220ms ease; border-radius: 6px; }
    @media (hover: hover) { .recent-row:hover::before { opacity: 1; } }
    .recent-row h3 { font-size: 23px; line-height: 1.4; font-weight: 600; overflow-wrap: anywhere; transition: color 220ms ease; }
    .recent-row__summary { max-width: 60ch; margin: 10px auto 0; color: var(--text-muted); font-size: 15px; line-height: 1.75; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .recent-row time { font-size: 13px; }
    .recent-list__desc { display: none; }
    .recent-row:hover h3 { color: var(--accent); }
  }

  @media (max-width: 640px) {
    :root:not([data-theme='dark']) {
      .recent .module-head h2, .lab .module-head h2 { font-size: 20px; }
      .recent-row { gap: 12px; padding-block: 28px; }
      .recent-row h3 { font-size: 20px; }
      .oneline__figure blockquote { font-size: 23px; }
      .oneline { padding-block: 36px; }
    }
  }
</style>
