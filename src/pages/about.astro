---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout title="About — Aloha" description="Aloha — learning backend development.">
  <section class="page-head container">
    <a class="back-home" href="/" data-reveal><span aria-hidden="true">←</span> 返回主页</a>
    <p class="eyebrow" data-reveal style="--reveal-delay: 60ms">/ about</p>
  </section>

  <section class="about container" aria-label="About">
    <h1 data-reveal style="--reveal-delay: 120ms"><span data-scramble>Aloha</span><span class="about__cursor" aria-hidden="true">_</span></h1>
    <p class="about__line" data-reveal style="--reveal-delay: 200ms" data-scramble>learning backend development.</p>

    <dl class="about__facts" data-reveal style="--reveal-delay: 400ms">
      <div class="about__fact">
        <dt data-scramble>email</dt>
        <dd><a href="mailto:292081295@qq.com" data-scramble>292081295@qq.com</a></dd>
      </div>
      <div class="about__fact">
        <dt data-scramble>github</dt>
        <dd><a href="https://github.com/A1oha666" target="_blank" rel="noopener" data-scramble>@A1oha666</a></dd>
      </div>
      <div class="about__fact">
        <dt data-scramble>Location</dt>
        <dd data-scramble>Here</dd>
      </div>
    </dl>
  </section>
  <SiteFooter />
</BaseLayout>

<style>
  /* .page-head / .back-home / .eyebrow 样式在 global.css 统一维护 */
  .about { padding-bottom: var(--space-4xl); }
  h1 {
    font-family: var(--mono);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 500;
    line-height: 1.1;
  }
  /* 终端式硬闪烁光标，节奏与首页 Hero 横线光标一致（2.6s steps(1)） */
  .about__cursor {
    margin-left: 2px;
    color: var(--accent);
    animation: cursor-blink 2.6s steps(1) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .about__cursor { animation: none; }
  }

  .about__line {
    margin-top: var(--space-lg);
    max-width: 46ch;
    font-family: var(--mono);
    font-size: 0.95rem;
    color: var(--text);
  }
  .about__line--dim { color: var(--text-faint); }

  .about__facts {
    margin: var(--space-3xl) 0 0;
    display: grid;
    gap: var(--space-md);
    font-family: var(--mono);
    font-size: 13px;
  }
  .about__fact { display: flex; gap: var(--space-xl); align-items: baseline; }
  .about__fact dt { width: 5.5ch; flex-shrink: 0; color: var(--text-faint); }
  .about__fact dd { margin: 0; color: var(--text-muted); }
  .about__fact a { color: var(--text); text-decoration: none; border-bottom: 1px solid var(--border-strong); transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
  .about__fact a:hover { color: var(--accent); border-color: var(--accent); }
</style>
