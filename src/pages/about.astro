---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import DarkAbout from "../components/dark/DarkAbout.astro";
---

<BaseLayout lang="zh-CN" title="About — Aloha" description="一名 2028 届本科 CS 学生，正在学习后端开发，尝试掌握 Golang。">
  <section class="page-head container">
    <h1 data-reveal>关于我</h1>
  </section>

  {/* 深色分支：字符签名（dmesg 启动日志已按 D-2 决策全部移除，2026-09-16 签核） */}
  <div class="dark-about">
    <DarkAbout />
  </div>

  {/* 浅色分支：简洁的作者介绍与联系方式 */}
  <section class="about container light-about" aria-label="About">
    <div class="light-about__soul">
      <DarkAbout showFacts={false} variant="light" />
    </div>

    <dl class="about__facts" data-reveal style="--reveal-delay: 240ms">
      <div class="about__fact">
        <dt data-scramble>email</dt>
        <dd><a href="mailto:292081295@qq.com" data-scramble>292081295@qq.com</a></dd>
      </div>
      <div class="about__fact">
        <dt data-scramble>github</dt>
        <dd><a href="https://github.com/A1oha666" target="_blank" rel="noopener" data-scramble>@A1oha666</a></dd>
      </div>
    </dl>
  </section>
  <SiteFooter />
</BaseLayout>

<style>
  /* 主题分流 */
  :root:not([data-theme='dark']) .dark-about { display: none; }
  :root[data-theme='dark'] .light-about { display: none; }

  /* .page-head 样式在 global.css 统一维护 */
  /* 内容少时收窄到阅读宽度，避免通栏左对齐配三行字的空荡构图 */
  .about { max-width: var(--maxw-prose); padding-bottom: var(--space-4xl); }
  .light-about__soul :global(.dabout) {
    max-width: none;
    padding-inline: 0;
    padding-bottom: var(--space-2xl);
  }
  .about__facts {
    margin: var(--space-3xl) 0 0;
    display: grid;
    gap: var(--space-md);
    font-family: var(--mono);
    font-size: 13px;
  }
  .about__fact { display: flex; gap: var(--space-xl); align-items: baseline; }
  /* mono 在 .about__facts 上声明；但 :lang(zh) 会直接命中包括中间 div 在内的
     每个元素，inherit 会解析到被污染的父级，因此这里必须显式声明 mono */
  .about__fact dt, .about__fact dd, .about__fact a { font-family: var(--mono); }
  .about__fact dt { width: 5.5ch; flex-shrink: 0; color: var(--text-faint); }
  .about__fact dd { margin: 0; color: var(--text-muted); }
  .about__fact a { color: var(--text); text-decoration: none; border-bottom: 1px solid var(--border-strong); transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
  .about__fact a:hover { color: var(--accent); border-color: var(--accent); }
</style>
