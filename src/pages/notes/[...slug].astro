---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleLayout from "../../components/ArticleLayout.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { readingTimeText } from "../../lib/format";
import { getArticleStaticPaths, toAdjacentArticle, render } from "../../lib/article-page";

// Astro 5 依赖编译期静态分析识别 getStaticPaths，不能把它抽成跨模块工厂
// （会丢失路由-路径函数关联，Astro.props 为空）。这里保留本地薄壳。
export async function getStaticPaths() {
  return getArticleStaticPaths("notes");
}

const { entry, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<BaseLayout lang="zh-CN" title={`${entry.data.title} — Notes — Aloha`} description={entry.data.summary}>
  <ArticleLayout
    collectionLabel="Notes"
    collectionHref="/notes/"
    title={entry.data.title}
    date={entry.data.date}
    updated={entry.data.editedAt}
    summary={entry.data.summary}
    cover={entry.data.cover}
    readingTime={readingTimeText(entry.body)}
    headings={headings}
    views={entry.data.views}
    viewType="notes"
    viewSlug={entry.id}
    previous={toAdjacentArticle(previous)}
    next={toAdjacentArticle(next)}
  >
    <Content />
  </ArticleLayout>
  <SiteFooter />
</BaseLayout>
