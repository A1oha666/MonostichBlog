---
import Nav from "../components/Nav.astro";
import { ClientRouter } from "astro:transitions";
import "@fontsource/fraunces/400.css";
import "@fontsource/fraunces/400-italic.css";
import "@fontsource/fraunces/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/400-italic.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  hideNav?: boolean;
  pageStylesheet?: string;
  bodyClass?: string;
  lang?: string;
}
const {
  title = "Aloha — backend & agent engineering",
  description =
    "Personal site & blog: backend development, distributed systems, and LLM agent applications.",
  hideNav = false,
  pageStylesheet,
  bodyClass,
  lang = "en",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Aloha" href="/rss.xml" />
    {pageStylesheet && <link rel="stylesheet" href={pageStylesheet} />}
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function () {
        var THEME_COLOR = { dark: "#101216", light: "#f4f3ee" };
        var applyTheme = function () {
          var t;
          try {
            t = localStorage.getItem("theme");
          } catch (e) {}
          if (t !== "light" && t !== "dark") t = "dark";
          document.documentElement.dataset.theme = t;
          // 移动浏览器 UI 跟随页面主题，避免浅色主题下地址栏仍是黑色
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", THEME_COLOR[t]);
          var btn = document.getElementById("theme-toggle");
          if (btn) btn.setAttribute("aria-label", t === "dark" ? "Switch to light theme" : "Switch to dark theme");
        };
        applyTheme();
        // 视图过渡会用新页面（服务端渲染、无 data-theme / 无 class）的属性
        // 整体替换 <html>，客户端导航后必须重新应用一次，否则浅色会被重置
        // 回深色，html.js 也会丢失（CSS 里 html:not(.js) 的 JS-可用分支会
        // 误判成无 JS）
        document.addEventListener("astro:after-swap", function () {
          applyTheme();
          document.documentElement.classList.add("js");
        });
      })();
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to main content</a>
    {!hideNav && <Nav />}
    <main id="main">
      <slot />
    </main>
    <script>
      // Scroll-reveal: fade+rise items marked with [data-reveal] once, when
      // they enter the viewport. Play-once (no reverse) avoids re-triggering
      // on every scroll direction change. Rescanned on astro:page-load so it
      // keeps working under view transitions.
      function setupReveal() {
        const items = document.querySelectorAll("[data-reveal]:not(.is-revealed)");
        if (!("IntersectionObserver" in window)) {
          items.forEach((el) => el.classList.add("is-revealed"));
          return;
        }
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );
        for (const el of items) {
          if (reducedMotion) {
            el.classList.add("is-revealed");
          } else {
            observer.observe(el);
          }
        }
      }
      document.addEventListener("astro:page-load", setupReveal);
      // runs now too (module scripts are deferred); setupReveal is idempotent
      setupReveal();
    </script>
    <script>
      // 乱码解码标题：[data-scramble] 元素进入视口后，字符从符号池随机
      // 翻滚，从左到右逐个"定稿"为原字符；未定稿字符用 .scramble-glyph
      // 染成暗橙（见 global.css）。与 reveal 同样监听 astro:page-load、
      // 幂等，reduced-motion 下不注册 observer，直接显示原文。
      function setupScramble() {
        const items = document.querySelectorAll("[data-scramble]");
        if (!items.length) return;
        if (!("IntersectionObserver" in window)) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const GLYPHS = "!<>-_\\/[]{}=+*^?#@%&";
        const settleFrame = (i: number) => 8 + i * 3;

        function scramble(el: HTMLElement) {
          const original = el.textContent ?? "";
          if (!original || el.dataset.scrambleDone === "1") return;
          el.dataset.scrambleDone = "1";
          const len = original.length;
          const total = settleFrame(len - 1) + 6;
          let frame = 0;
          function tick() {
            let out = "";
            for (let i = 0; i < len; i++) {
              if (frame >= settleFrame(i) || original[i] === " ") {
                out += original[i];
              } else {
                const glyph = GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
                out += `<span class="scramble-glyph">${glyph}</span>`;
              }
            }
            el.innerHTML = out;
            frame++;
            if (frame <= total) {
              requestAnimationFrame(tick);
            } else {
              el.textContent = original; // 全部定稿后清理 DOM
            }
          }
          requestAnimationFrame(tick);
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              observer.unobserve(entry.target);
              scramble(entry.target as HTMLElement);
            }
          },
          { threshold: 0.6 },
        );
        items.forEach((el) => {
          if (el.dataset.scrambleBound === "1") return;
          el.dataset.scrambleBound = "1";
          observer.observe(el);
        });
      }
      document.addEventListener("astro:page-load", setupScramble);
      setupScramble();
    </script>
  </body>
</html>
