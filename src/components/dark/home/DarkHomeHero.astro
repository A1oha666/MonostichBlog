---
/**
 * DarkHomeHero —— 深色首页 Hero 区块
 *
 * HUD 命令行 + 磁力大标题 + 中文独白 + CTA + 滚动提示
 * 底：从视口右缘流向信号核的曲线星图连线（SVG，虚线流动）
 *
 * 背景（SignalCore / DarkGrain）由父级 DarkHome 提供，这里只管内容。
 */
import { ArrowRight } from '@lucide/astro';
---

<div class="dhero container">
  <p class="dhero__colophon">
    <span class="dhero__prompt">aloha@monostich</span><span class="dhero__faint">:</span><span class="dhero__path">~</span><span class="dhero__dollar">$</span>
    <span class="dhero__cmd"> ./boot --mode=explore</span>
  </p>

  <div class="dhero__layout">
    <div class="dhero__inner">
      <p class="dhero__eyebrow">// blog &amp; notes — signal over noise</p>
      <h1 class="dhero__title">
        <span class="dhero__line" data-magnet="14">explore</span>
        <span class="dhero__line" data-magnet="14">and&nbsp;build<span class="dhero__dot">.</span><span class="dhero__cursor">_</span></span>
      </h1>
      <p class="dhero__intro" lang="zh-CN">记录一些想法与实践 —— 后端、分布式，以及 LLM 时代的造物。</p>
      <div class="dhero__actions">
        <a class="dhero__link dhero__link--primary" href="#recent">阅读记录 <ArrowRight size={15} aria-hidden="true" /></a>
        <a class="dhero__link dhero__link--ghost" href="/about">关于我</a>
      </div>
      <p class="dhero__scrollhint" aria-hidden="true"><span class="dhero__scrollline"></span>scroll</p>
    </div>
  </div>

  <!-- 星图连线：从右缘向信号核输送数据的三条曲线 -->
  <svg class="dhero__links" viewBox="0 0 600 400" preserveAspectRatio="none" aria-hidden="true">
    <path d="M600,60 C460,60 420,150 330,175" />
    <path d="M600,210 C480,205 430,195 340,190" />
    <path d="M600,350 C470,340 420,250 330,205" />
  </svg>
</div>

<style>
  .dhero { position: relative; z-index: 2; }

  /* ---------- 命令行眉批 ---------- */
  .dhero__colophon {
    padding-top: 34px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-faint);
  }
  .dhero__prompt { color: var(--text-muted); }
  .dhero__faint { color: var(--text-faint); }
  .dhero__path { color: var(--text-muted); }
  .dhero__dollar { color: var(--accent); margin-left: 8px; }
  .dhero__cmd { color: var(--text-faint); }
  @media (max-width: 600px) { .dhero__cmd { display: none; } }

  /* ---------- 布局 ---------- */
  .dhero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 236px;
    align-items: end;
    gap: 72px;
    padding-top: clamp(72px, 13vh, 150px);
    padding-bottom: clamp(64px, 11vh, 130px);
  }

  .dhero__eyebrow {
    margin-bottom: var(--space-lg);
    color: var(--accent);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .dhero__title {
    margin: 0;
    font-family: var(--mono);
    font-weight: 500;
    font-size: clamp(46px, 8.2vw, 96px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    /* 纯色冷白 + 克制的辉光，不靠背景垫 */
    color: #eef1f6;
    text-shadow:
      0 0 28px rgba(140, 170, 255, 0.22),
      0 0 90px rgba(120, 150, 255, 0.10);
  }
  .dhero__line { display: block; will-change: transform; }
  .dhero__dot { color: var(--accent); }
  .dhero__cursor { margin-left: 0.04em; color: var(--accent); animation: cursor-blink 1.6s steps(1) infinite; }

  .dhero__intro {
    margin-top: 26px;
    max-width: 30ch;
    font-family: 'Google Sans', var(--font-zh);
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
  }

  /* ---------- CTA ---------- */
  .dhero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .dhero__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 18px;
    font-family: var(--mono);
    font-size: 12.5px;
    border: 1px solid var(--border-strong);
    color: var(--text);
    transition: border-color var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .dhero__link--primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .dhero__link--primary:hover { background: var(--accent-deep); border-color: var(--accent-deep); transform: translateY(-1px); }
  .dhero__link--primary :global(svg) { transition: transform 250ms var(--ease-out); }
  .dhero__link--primary:hover :global(svg) { transform: translateX(3px); }
  .dhero__link--ghost { color: var(--text-muted); background: transparent; }
  .dhero__link--ghost:hover { color: var(--text); border-color: var(--text-muted); transform: translateY(-1px); }

  /* ---------- 滚动提示 ---------- */
  .dhero__scrollhint {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: clamp(40px, 7vh, 80px);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.28em;
    color: var(--text-faint);
    text-transform: uppercase;
  }
  .dhero__scrollline {
    position: relative;
    width: 54px;
    height: 1px;
    background: var(--border-strong);
    overflow: hidden;
  }
  .dhero__scrollline::after {
    content: '';
    position: absolute;
    inset: 0;
    width: 22px;
    background: var(--accent);
    animation: scroll-sweep 2.2s var(--ease-out) infinite;
  }
  @keyframes scroll-sweep {
    0% { transform: translateX(-24px); }
    70%, 100% { transform: translateX(56px); }
  }
  @media (prefers-reduced-motion: reduce) { .dhero__scrollline::after { animation: none; } }

  /* ---------- 星图连线 ---------- */
  .dhero__links {
    position: absolute;
    right: -48px;
    top: 12%;
    width: min(46vw, 600px);
    height: 60%;
    pointer-events: none;
    opacity: 0.5;
  }
  .dhero__links path {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1;
    stroke-dasharray: 3 9;
    animation: dash-flow 7s linear infinite;
  }
  .dhero__links path:nth-child(2) { animation-duration: 9s; animation-delay: -3s; }
  .dhero__links path:nth-child(3) { animation-duration: 11s; animation-delay: -6s; }
  @keyframes dash-flow { to { stroke-dashoffset: -120; } }
  @media (prefers-reduced-motion: reduce) { .dhero__links path { animation: none; } }
  @media (max-width: 900px) { .dhero__links { display: none; } }

  /* ---------- 响应式 ---------- */
  @media (max-width: 1100px) and (min-width: 601px) {
    .dhero__layout { grid-template-columns: minmax(0, 1fr) 200px; gap: 36px; }
  }
  @media (max-width: 600px) {
    .dhero__layout { grid-template-columns: 1fr; gap: 40px; padding-top: 96px; padding-bottom: 56px; align-items: start; }
    .dhero__intro { max-width: 26ch; }
  }
</style>

