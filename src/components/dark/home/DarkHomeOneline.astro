---
/**
 * DarkHomeOneline —— 「随想」Bento 区
 *
 * 左：一行小记，以玻璃卡承载，鼠标经过时卡面浮现跟随光斑（spotlight），
 *    边框辉光由全局 spotlight 变量驱动（见 DarkHome）。
 * 右：活体终端（DarkHomeTerminal）。
 */
import DarkHomeTerminal from './DarkHomeTerminal.astro';
import { dotDate, isoDate } from '../../../lib/format';

interface Moment {
  id: string;
  date: Date;
  text: string;
}
interface Props {
  moment?: Moment;
}
const { moment } = Astro.props;
---

<section class="oneline container" aria-labelledby="home-oneline-heading">
  <div class="module-head" data-reveal>
    <h2 id="home-oneline-heading" data-scramble data-no="01">随想</h2>
    <a href="/thinkings">小记 →</a>
  </div>

  <div class:list={['bento', { 'bento--solo': !moment }]}>
    {moment && (
      <figure class="glass oneline__figure" data-reveal style="--reveal-delay: 80ms" data-spotlight>
        <span class="oneline__tag" aria-hidden="true">stdin: thought.log</span>
        <blockquote lang="zh-CN">
          <a href={`/thinkings#${moment.id}`}>{moment.text}</a>
        </blockquote>
        <figcaption>
          <time datetime={isoDate(moment.date)}>{dotDate(moment.date)}</time>
          <span class="oneline__sig" aria-hidden="true">— eof</span>
        </figcaption>
      </figure>
    )}
    <div class="oneline__term" data-reveal style="--reveal-delay: 160ms">
      <DarkHomeTerminal />
    </div>
  </div>
</section>

<style>
  .oneline { padding-block: var(--space-3xl) var(--space-2xl); }

  .bento {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 16px;
    align-items: stretch;
  }
  .bento--solo { grid-template-columns: 1fr; }
  .bento--solo .oneline__term { max-width: 640px; }

  /* ---------- 玻璃卡（spotlight 变量由全局脚本写入） ---------- */
  .glass {
    position: relative;
    margin: 0;
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    overflow: hidden;
  }
  /* 鼠标光斑：径向辉光跟随 --mx/--my */
  .glass::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      340px circle at var(--mx, 50%) var(--my, 50%),
      rgba(122, 148, 255, 0.10),
      transparent 68%
    );
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
    pointer-events: none;
  }
  .glass:hover::before { opacity: 1; }
  /* 顶部一道冷色高光，像玻璃的边缘 */
  .glass::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(160, 180, 255, 0.35), transparent);
    pointer-events: none;
  }

  .oneline__figure {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: clamp(24px, 3.4vw, 44px);
  }
  .oneline__tag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--text-faint);
    text-transform: uppercase;
  }
  .oneline__figure blockquote {
    position: relative;
    margin: 0;
    padding-left: 1.15em;
    max-width: 24ch;
    font-size: clamp(24px, 2.6vw, 34px);
    font-weight: 400;
    line-height: 1.55;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .oneline__figure blockquote::before {
    content: '>';
    position: absolute;
    left: 0;
    font-family: var(--mono);
    color: var(--accent-dim);
  }
  .oneline__figure blockquote a { color: inherit; transition: color var(--dur-base) var(--ease-out); }
  .oneline__figure blockquote a:hover { color: var(--accent); }
  .oneline__figure figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .oneline__sig { letter-spacing: 0.14em; }

  @media (max-width: 860px) {
    .bento { grid-template-columns: 1fr; }
  }
</style>
