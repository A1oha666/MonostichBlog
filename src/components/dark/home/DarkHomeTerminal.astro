---
/**
 * DarkHomeTerminal —— 活体终端
 *
 * 一台永远在自言自语的终端：命令逐字敲入，输出以不同着色回流，
 * 跑完一轮后静默片刻再重新开始。Konami 彩蛋（↑↑↓↓←→←→BA）会打断
 * 正常剧本，插入一段 sudo 小剧场 —— 由 DarkHome 全局派发 CustomEvent('konami')。
 *
 * 性能：纯 setTimeout 链 + 文本节点追加；离屏经 IntersectionObserver 暂停；
 * reduced-motion 直接倾倒全部文本；before-swap 清理全部定时器。
 */

interface TermLine { t: string; c: 'cmd' | 'out' | 'ok' | 'warn' | 'err' | 'amber' }

const SCRIPT: TermLine[] = [
  { t: 'whoami', c: 'cmd' },
  { t: 'aloha — backend & agent engineering', c: 'out' },
  { t: 'uname -a', c: 'cmd' },
  { t: 'monostich 6.9.0-curiosity x86_64 GNU/thoughts', c: 'out' },
  { t: 'tail -n 3 /var/log/thoughts.log', c: 'cmd' },
  { t: '[ok] 把复杂留给系统，把简单留给读者', c: 'ok' },
  { t: '[ok] 分布式共识，先是与自己的共识', c: 'ok' },
  { t: '[warn] caffeine low — reducing GC frequency', c: 'warn' },
  { t: 'systemctl status sleep.service', c: 'cmd' },
  { t: '● inactive (dead) — since 2019', c: 'err' },
];

const KONAMI_SCRIPT: TermLine[] = [
  { t: 'sudo make me_a_sandwich', c: 'cmd' },
  { t: '[sudo] password for aloha: **********', c: 'out' },
  { t: '🥪 sandwich.service — active (served)', c: 'ok' },
  { t: 'achievement unlocked: ↑↑↓↓←→←→BA', c: 'amber' },
];
---

<div class="term" data-term data-script={JSON.stringify(SCRIPT)} data-konami={JSON.stringify(KONAMI_SCRIPT)}>
  <div class="term__bar">
    <span class="term__dot term__dot--r"></span>
    <span class="term__dot term__dot--y"></span>
    <span class="term__dot term__dot--g"></span>
    <span class="term__title">aloha@monostich: ~/logs</span>
    <span class="term__badge" data-term-badge>live</span>
  </div>
  <div class="term__body" data-term-body aria-hidden="true"></div>
</div>

<style>
  .term {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 300px;
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    overflow: hidden;
  }
  .term__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--mono);
    font-size: 10.5px;
    color: var(--text-faint);
  }
  .term__dot { width: 9px; height: 9px; border-radius: 50%; opacity: 0.85; }
  .term__dot--r { background: #ff5f57; }
  .term__dot--y { background: #febc2e; }
  .term__dot--g { background: #28c840; }
  .term__title { margin-left: 6px; letter-spacing: 0.04em; }
  .term__badge {
    margin-left: auto;
    padding: 2px 7px;
    border: 1px solid var(--accent-dim);
    color: var(--accent);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    animation: badge-pulse 2.4s ease-in-out infinite;
  }
  @keyframes badge-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
  @media (prefers-reduced-motion: reduce) { .term__badge { animation: none; } }

  .term__body {
    flex: 1;
    padding: 16px 16px 20px;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.9;
    overflow: hidden;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .term__body :global(.tl) { display: block; min-height: 1.9em; }
  .term__body :global(.tl--cmd) { color: var(--text); }
  .term__body :global(.tl--cmd)::before { content: '$ '; color: var(--accent); }
  .term__body :global(.tl--out) { color: var(--text-muted); }
  .term__body :global(.tl--ok) { color: var(--code-green); }
  .term__body :global(.tl--warn) { color: var(--accent); }
  .term__body :global(.tl--err) { color: #ff6b5e; }
  .term__body :global(.tl--amber) { color: var(--accent); text-shadow: 0 0 12px var(--accent-glow); }
  .term__body :global(.tl__cursor) {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 1px;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: cursor-blink 1.1s steps(1) infinite;
  }
  @media (max-width: 600px) {
    .term { min-height: 260px; }
    .term__body { font-size: 11px; }
  }
</style>

<script>
  let teardownTerm: (() => void) | null = null;

  function setupTerm() {
    if (document.documentElement.dataset.theme !== 'dark') return;
    const root = document.querySelector<HTMLElement>('[data-term]');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const body = root.querySelector<HTMLElement>('[data-term-body]')!;
    const badge = root.querySelector<HTMLElement>('[data-term-badge]');
    interface TermLine { t: string; c: string }
    let SCRIPT: TermLine[] = [];
    let KONAMI: TermLine[] = [];
    try { SCRIPT = JSON.parse(root.dataset.script || '[]'); } catch {}
    try { KONAMI = JSON.parse(root.dataset.konami || '[]'); } catch {}

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const timers: ReturnType<typeof setTimeout>[] = [];
    let visible = true;
    let stopped = false;
    let konamiArmed = false;

    let generation = 0;   // 代际：cancelQueued 递增，旧代的回调全部失效
    let waiters: Array<() => void> = [];  // 离屏时挂起的恢复点
    const later = (fn: () => void, ms: number) => {
      const gen = generation;
      const id = setTimeout(() => {
        if (stopped || gen !== generation) return;
        if (visible) fn();
        else waiters.push(fn);            // 离屏：挂起而非空转
      }, ms);
      timers.push(id);
    };
    function cancelQueued() {
      timers.splice(0).forEach(clearTimeout);
      waiters = [];
      generation++;
    }
    function resumeWaiters() {
      const pending = waiters;
      waiters = [];
      pending.forEach((fn) => { if (!stopped) fn(); });
    }

    function addCursor(line: HTMLElement) {
      const c = document.createElement('span');
      c.className = 'tl__cursor';
      line.appendChild(c);
      return c;
    }
    function newLine(cls: string): HTMLElement {
      const el = document.createElement('span');
      el.className = `tl tl--${cls}`;
      body.appendChild(el);
      return el;
    }
    function clearBody() { body.textContent = ''; }

    // 逐字敲入一行；中文/标点稍慢，模拟真实击键节奏
    function typeLine(line: TermLine, done: () => void) {
      const el = newLine(line.c);
      const textNode = document.createTextNode('');
      el.appendChild(textNode);
      const cursor = addCursor(el);
      const text = line.t;
      let i = 0;
      const speed = line.c === 'cmd' ? 46 : 12;
      const step = () => {
        i++;
        textNode.textContent = text.slice(0, i);
        if (i < text.length) {
          const ch = text[i - 1];
          const extra = /[一-鿿　-〿]/.test(ch) ? 34 : Math.random() * 22;
          later(step, speed + extra);
        } else {
          cursor.remove();
          later(done, line.c === 'cmd' ? 260 : 420);
        }
      };
      step();
    }

    function runScript(lines: TermLine[], then: () => void, idx = 0) {
      if (idx >= lines.length) { then(); return; }
      typeLine(lines[idx], () => runScript(lines, then, idx + 1));
    }

    function idlePrompt(ms: number, then: () => void) {
      const el = newLine('cmd');
      addCursor(el);
      later(() => { el.remove(); then(); }, ms);
    }

    function loop() {
      if (stopped) return;
      clearBody();
      if (konamiArmed) {
        runScript(KONAMI, () => idlePrompt(9000, () => { konamiArmed = false; loop(); }));
        return;
      }
      runScript(SCRIPT, () => idlePrompt(6500, loop));
    }

    function dumpStatic() {
      clearBody();
      for (const line of [...SCRIPT, { t: '', c: 'cmd' }]) {
        const el = newLine(line.c);
        el.textContent = line.t;
      }
      if (badge) badge.textContent = 'static';
    }

    function onKonami() {
      if (stopped || reduced) return;
      // 打断当前剧本：取消全部排队任务，直接进彩蛋
      cancelQueued();
      konamiArmed = true;
      loop();
    }

    const io = new IntersectionObserver(([entry]) => {
      const was = visible;
      visible = entry.isIntersecting;
      if (visible && !was) resumeWaiters();   // 回屏：从断点恢复
    });
    io.observe(root);
    document.addEventListener('konami', onKonami);

    if (reduced) dumpStatic();
    else loop();

    teardownTerm = () => {
      stopped = true;
      timers.splice(0).forEach(clearTimeout);
      io.disconnect();
      document.removeEventListener('konami', onKonami);
      delete root.dataset.bound;
    };
  }

  document.addEventListener('astro:page-load', setupTerm);
  document.addEventListener('themechange', () => { teardownTerm?.(); teardownTerm = null; setupTerm(); });
  document.addEventListener('astro:before-swap', () => { teardownTerm?.(); teardownTerm = null; });
  setupTerm();
</script>
