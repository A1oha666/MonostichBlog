---
/**
 * DarkHomeLab —— 实验室 · gutter 行号列表（与文章区同构，右侧露 kind）
 */
import { lab } from '../../../data/lab.js';
---

<section class="section container lab" aria-labelledby="home-lab-heading">
  <div class="module-head" data-reveal>
    <h2 id="home-lab-heading" data-scramble data-no="03">实验室</h2>
    <a href="/lab/" aria-label="全部实验">全部 →</a>
  </div>
  <ol class="lab-list" lang="zh-CN">
    {lab.map((item, index) => (
      <li data-reveal style={`--reveal-delay: ${Math.min(index * 60, 120)}ms`}>
        <a class="lab-row" href={item.href} data-spotlight>
          <span class="lab-list__no" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="lab-row__body">
            <h3>{item.name}</h3>
          </span>
          <span class="lab-row__desc">{item.desc}</span>
          <span class="lab-row__kind" aria-hidden="true">{item.kind}</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .lab-list { list-style: none; padding: 0; margin: 0; }
  .lab-list > li { border-bottom: 1px solid var(--border-subtle); }
  .lab-list > li:first-child { border-top: 1px solid var(--border-subtle); }

  .lab-list__no {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    align-self: stretch;
    padding-right: 18px;
    border-right: 1px solid var(--border-subtle);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-base) var(--ease-out);
  }

  .lab-row {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, auto) minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 22px;
    padding-block: 20px;
    isolation: isolate;
  }
  .lab-row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      300px circle at var(--mx, 50%) 50%,
      rgba(122, 148, 255, 0.07),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 320ms var(--ease-out);
  }
  .lab-row:hover::before { opacity: 1; }

  .lab-row h3 {
    font-family: 'Google Sans', var(--font-zh);
    font-size: 1.05rem;
    font-weight: 400;
    white-space: nowrap;
    transition: transform var(--dur-base) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .lab-row__desc {
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 11.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--dur-base) var(--ease-out);
  }
  .lab-row__kind {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    white-space: nowrap;
    transition: color var(--dur-base) var(--ease-out);
  }

  .lab-list > li:focus-within .lab-list__no,
  .lab-row:hover .lab-list__no { color: var(--accent); }
  .lab-row:hover h3 { transform: translateX(6px); color: var(--accent); }
  .lab-row:hover .lab-row__desc { color: var(--text-muted); }
  .lab-row:hover .lab-row__kind { color: var(--text-muted); }

  @media (max-width: 640px) {
    .lab-row { grid-template-columns: 40px minmax(0, 1fr); row-gap: 4px; padding-block: 16px; }
    .lab-list__no { padding-right: 12px; }
    .lab-row__desc { grid-column: 2; white-space: normal; }
    .lab-row__kind { display: none; }
  }
</style>
