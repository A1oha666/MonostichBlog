---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface AdjacentArticle {
  title: string;
  href: string;
}

interface Props {
  collectionLabel: string;
  collectionHref: string;
  title: string;
  date: Date | string;
  updated?: Date | string | null;
  summary: string;
  cover: string;
  readingTime: string;
  headings: Heading[];
  previous?: AdjacentArticle;
  next?: AdjacentArticle;
}

const {
  collectionLabel,
  collectionHref,
  title,
  date,
  updated = null,
  summary,
  cover,
  readingTime,
  headings,
  previous,
  next,
} = Astro.props;

const publishedDate = date instanceof Date ? date : new Date(date);
const editedDate = updated instanceof Date ? updated : updated ? new Date(updated) : null;
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const formatDate = (value: Date) => value.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
---

<article class="article">
  <header class="article__header container">
    <a class="back-link" href={collectionHref}><span aria-hidden="true">←</span> 返回{collectionLabel}</a>
    <p class="article__eyebrow">/ {collectionLabel.toLowerCase()}</p>
    <h1>{title}</h1>
    <p class="article__summary">{summary}</p>
    <div class="article__meta">
      <time datetime={publishedDate.toISOString()}>{formatDate(publishedDate)}</time>
      <span>{readingTime}</span>
      {editedDate && <span>更新于 {formatDate(editedDate)}</span>}
    </div>
  </header>

  {cover && <div class="article__cover container"><img src={cover} alt="" /></div>}

  <div class="article__layout container">
    {tocHeadings.length > 0 && (
      <aside class="article__toc" aria-label="文章目录">
        <p>目录</p>
        <ol>
          {tocHeadings.map((heading) => (
            <li class:list={[heading.depth === 3 && "article__toc-item--nested"]}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </aside>
    )}
    <div class="article__content">
      <slot />
    </div>
  </div>

  <nav class="article__pagination container" aria-label="文章导航">
    {previous ? <a href={previous.href}><span>上一篇</span><strong>{previous.title}</strong></a> : <span></span>}
    {next ? <a class="article__pagination-next" href={next.href}><span>下一篇</span><strong>{next.title}</strong></a> : <span></span>}
  </nav>
</article>

<style>
  .article__header { max-width: 1080px; padding-top: var(--space-4xl); padding-bottom: var(--space-3xl); }
  .back-link { display: inline-flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-xl); border: 1px solid var(--border-strong); border-radius: var(--radius-sm); padding: 7px 10px; color: var(--text-muted); font-family: var(--mono); font-size: 12px; transition: border-color 180ms ease, color 180ms ease; }
  .back-link span, .article__eyebrow { color: var(--accent); }
  .back-link:hover { border-color: var(--accent); color: var(--text); }
  .article__eyebrow { margin-bottom: var(--space-lg); font-family: var(--mono); font-size: 13px; }
  h1 { max-width: 14ch; font-size: clamp(2.5rem, 5.5vw, 5rem); font-weight: 500; line-height: 1.04; }
  .article__summary { max-width: 58ch; margin-top: var(--space-xl); color: var(--text-muted); font-size: 1.08rem; }
  .article__meta { display: flex; flex-wrap: wrap; gap: var(--space-md); margin-top: var(--space-xl); color: var(--text-faint); font-family: var(--mono); font-size: 12px; }
  .article__meta span + span::before { content: "/"; margin-right: var(--space-md); color: var(--border-strong); }
  .article__cover img { width: 100%; max-height: 620px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); object-fit: cover; }
  .article__layout { display: grid; grid-template-columns: 172px minmax(0, 720px); justify-content: center; gap: var(--space-3xl); padding-top: var(--space-2xl); }
  .article__toc { position: sticky; top: calc(var(--nav-height) + var(--space-lg)); align-self: start; border-left: 1px solid var(--border); padding-left: var(--space-md); font-family: var(--mono); font-size: 12px; }
  .article__toc > p { color: var(--text-faint); }
  .article__toc ol { display: grid; gap: var(--space-sm); margin: var(--space-md) 0 0; padding: 0; list-style: none; }
  .article__toc a { color: var(--text-muted); line-height: 1.45; }
  .article__toc a:hover { color: var(--accent); }
  .article__toc-item--nested { padding-left: var(--space-sm); }
  .article__content { min-width: 0; padding-bottom: var(--space-4xl); }
  .article__pagination { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xl); padding-top: var(--space-xl); padding-bottom: var(--space-4xl); border-top: 1px solid var(--border-strong); }
  .article__pagination a { display: grid; gap: var(--space-sm); color: var(--text-muted); }
  .article__pagination a:hover strong { color: var(--accent); }
  .article__pagination span { color: var(--text-faint); font-family: var(--mono); font-size: 11.5px; }
  .article__pagination strong { font-size: 1.05rem; font-weight: 500; transition: color 180ms ease; }
  .article__pagination-next { text-align: right; }
  :global(.article__content > :first-child) { margin-top: 0; }
  :global(.article__content h2) { margin-top: var(--space-3xl); font-size: clamp(1.6rem, 3vw, 2.25rem); font-weight: 500; scroll-margin-top: calc(var(--nav-height) + var(--space-lg)); }
  :global(.article__content h3) { margin-top: var(--space-2xl); font-size: 1.3rem; font-weight: 500; scroll-margin-top: calc(var(--nav-height) + var(--space-lg)); }
  :global(.article__content p), :global(.article__content ul), :global(.article__content ol) { margin-top: var(--space-lg); }
  :global(.article__content li + li) { margin-top: var(--space-sm); }
  :global(.article__content a) { color: var(--accent); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent); text-underline-offset: 3px; }
  :global(.article__content blockquote) { margin: var(--space-xl) 0 0; border-left: 2px solid var(--accent); padding-left: var(--space-lg); color: var(--text-muted); }
  :global(.article__content pre) { margin-top: var(--space-xl); border: 1px solid var(--border-strong); border-radius: var(--radius-sm); padding: var(--space-lg); overflow-x: auto; background: var(--surface); font-family: var(--mono); font-size: 13px; line-height: 1.7; }
  :global(.article__content code) { font-family: var(--mono); }
  :global(.article__content :not(pre) > code) { border: 1px solid var(--border); border-radius: 4px; padding: 1px 5px; background: var(--accent-soft); font-size: 0.88em; }
  :global(.article__content img) { width: 100%; margin-top: var(--space-xl); border: 1px solid var(--border); border-radius: var(--radius-sm); }
  :global(.article__content hr) { margin: var(--space-3xl) 0; border: 0; border-top: 1px solid var(--border); }
  @media (max-width: 800px) {
    .article__header { padding-top: var(--space-3xl); }
    .article__layout { grid-template-columns: minmax(0, 720px); padding-top: var(--space-xl); }
    .article__toc { position: static; border-left: 0; border-bottom: 1px solid var(--border); padding: 0 0 var(--space-lg); }
    .article__toc ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .article__pagination { grid-template-columns: 1fr; }
    .article__pagination-next { text-align: left; }
    .article__toc ol { grid-template-columns: 1fr; }
  }
</style>
