---
import { safeDate, dotDate, isoDate } from "../lib/format";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface AdjacentArticle {
  title: string;
  href: string;
}

interface Props {
  collectionLabel: string;
  collectionHref: string;
  title: string;
  date: Date | string;
  updated?: Date | string | null;
  summary: string;
  cover: string;
  readingTime: string;
  headings: Heading[];
  previous?: AdjacentArticle;
  next?: AdjacentArticle;
  views?: number;
  viewType?: string;
  viewSlug?: string;
}

const {
  collectionLabel,
  collectionHref,
  title,
  date,
  updated = null,
  summary,
  cover,
  readingTime,
  headings,
  previous,
  next,
  views = 0,
  viewType,
  viewSlug,
} = Astro.props;

const publishedDate = safeDate(date);
const editedDate = updated ? safeDate(updated) : null;
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
// 与全站列表页同一制式：圆点日期（zh-CN locale 输出的是 2026/08/27 斜杠式）
const formatDate = dotDate;
---

<article class="article">
  <div class="article__progress" aria-hidden="true"></div>
  <header class="article__header container" data-pagefind-body>
    <a class="back-link" href={collectionHref} data-reveal><span aria-hidden="true">←</span> 返回{collectionLabel}</a>
    <p class="article__eyebrow" data-reveal style="--reveal-delay: 60ms">/ {collectionLabel.toLowerCase()}</p>
    <h1 data-reveal style="--reveal-delay: 120ms">{title}</h1>
    <p class="article__summary" data-reveal style="--reveal-delay: 200ms">{summary}</p>
    <div class="article__meta" data-reveal style="--reveal-delay: 280ms">
      <time datetime={isoDate(publishedDate)}>{formatDate(publishedDate)}</time>
      <span>{readingTime}</span>
      {viewType && viewSlug && (
        <span
          data-article-views
          data-view-type={viewType}
          data-view-slug={viewSlug}
        >{views} 次浏览</span>
      )}
      {editedDate && <span>更新于 {formatDate(editedDate)}</span>}
    </div>
  </header>

  {cover && <div class="article__cover container"><img src={cover} alt="" /></div>}

  <div class:list={["article__layout container", tocHeadings.length === 0 && "article__layout--no-toc"]}>
    {tocHeadings.length > 0 && (
      <aside class="article__toc" aria-label="文章目录">
        <details class="article__toc-disclosure" open>
        <summary>文章目录</summary>
        <ol>
          {tocHeadings.map((heading) => (
            <li class:list={[heading.depth === 3 && "article__toc-item--nested"]}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
        </details>
      </aside>
    )}
    <div class="article__content" data-pagefind-body>
      <slot />
    </div>
  </div>

  <nav class="article__pagination container" aria-label="文章导航">
    {previous ? <a href={previous.href}><span>上一篇</span><strong>{previous.title}</strong></a> : <span></span>}
    {next ? <a class="article__pagination-next" href={next.href}><span>下一篇</span><strong>{next.title}</strong></a> : <span></span>}
  </nav>
</article>

<script>
  // --- reading progress bar（模块级，只注册一次滚动监听） ---
  let progressEl: HTMLElement | null = null;
  let progressQueued = false;
  function updateProgress() {
    if (!progressEl) return;
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    progressEl.style.transform = `scaleX(${ratio})`;
  }
  // requestAnimationFrame 节流 + passive 监听，滚动开销可忽略
  window.addEventListener(
    "scroll",
    () => {
      if (progressQueued) return;
      progressQueued = true;
      requestAnimationFrame(() => {
        progressQueued = false;
        updateProgress();
      });
    },
    { passive: true },
  );

  // 目录滚动追踪： IntersectionObserver 记录可见标题，
  // 始终高亮文档顺序里最靠上的那个（Map 保持插入序）。
  // 代码块复制按钮：把每个 pre 包进定位容器，点击后写剪贴板并短暂反馈。
  // 视图过渡下 astro:page-load 在首次加载和每次客户端导航后触发，
  // 幂等初始化保证 上一篇/下一篇 跳转后功能仍然可用。
  function initArticleWidgets() {
    const disclosure = document.querySelector<HTMLDetailsElement>('.article__toc-disclosure');
    if (disclosure && !disclosure.dataset.bound) {
      disclosure.dataset.bound = 'true';
      const desktop = window.matchMedia('(min-width: 1280px)');
      const darkDesktop = window.matchMedia('(min-width: 801px)');
      const isDesktop = () => document.documentElement.dataset.theme === 'dark' ? darkDesktop.matches : desktop.matches;
      const syncDisclosure = () => { disclosure.open = isDesktop(); };
      syncDisclosure();
      desktop.addEventListener('change', syncDisclosure);
      darkDesktop.addEventListener('change', syncDisclosure);
      document.addEventListener('themechange', syncDisclosure);
      disclosure.addEventListener('click', (event) => {
        if (!isDesktop() && (event.target as Element).closest('a')) disclosure.open = false;
      });
      document.addEventListener('astro:before-swap', () => {
        desktop.removeEventListener('change', syncDisclosure);
        darkDesktop.removeEventListener('change', syncDisclosure);
        document.removeEventListener('themechange', syncDisclosure);
      }, { once: true });
    }
    // --- reading progress ---
    // 2px 进度条贴在 nav 下沿，按滚动比例 scaleX；纯位置映射非动画。
    // 监听器在模块层只注册一次（视图过渡不会重复执行本模块），
    // progressEl 则在每次 astro:page-load 后重新指向当前页的元素。
    progressEl = document.querySelector<HTMLElement>(".article__progress");
    if (progressEl) updateProgress();

    // --- view counter ---
    // POST 到 PocketBase 自定义路由做自增；同一会话内同一篇文章只计一次
    // （快照值来自构建时，命中后用服务端返回的最新值替换）。
    const viewsEl = document.querySelector<HTMLElement>("[data-article-views]");
    if (viewsEl && viewsEl.dataset.viewType && viewsEl.dataset.viewSlug) {
      const { viewType, viewSlug } = viewsEl.dataset;
      const seenKey = `viewed:${viewType}/${viewSlug}`;
      let seen = false;
      try {
        seen = sessionStorage.getItem(seenKey) === "1";
      } catch {}
      if (!seen) {
        const base = import.meta.env.PUBLIC_PB_BASE_URL
          ?? (location.hostname === "localhost" || location.hostname === "127.0.0.1"
            ? "http://127.0.0.1:8090"
            : "https://admin.monostich.cloud");
        fetch(`${base}/api/monostich/views`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ type: viewType, slug: viewSlug }),
        })
          .then((res) => (res.ok ? res.json() : null))
          .then((data) => {
            if (data && Number.isFinite(data.views)) {
              viewsEl.textContent = `${data.views} 次浏览`;
            }
            try {
              sessionStorage.setItem(seenKey, "1");
            } catch {}
          })
          .catch(() => {});
      }
    }

    // --- TOC scrollspy ---
    const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>(".article__toc a[href^='#']")];
    const spyTargets = new Map<Element, HTMLAnchorElement>();
    if (tocLinks.length > 0) {
      for (const link of tocLinks) {
        const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        if (target) spyTargets.set(target, link);
      }
    }

    // --- code copy buttons (skip already-wrapped blocks) ---
    // 包装时顺便读语言名写到 data-lang，.codeblock::before 用它渲染左上角语言条。
    // Shiki 会把语言写入 pre.data-language；无此属性说明语言被排除或未识别，
    // loader 侧 shikiConfig.langAlias 已规范化别名（golang/Java/Go）。
    document.querySelectorAll(".article__content pre").forEach((pre) => {
      const parent = pre.parentElement;
      if (!parent || parent.classList.contains("codeblock")) return;
      const wrapper = document.createElement("div");
      wrapper.className = "codeblock";
      wrapper.dataset.lang = pre.dataset.language ?? "text";
      pre.replaceWith(wrapper);
      wrapper.append(pre);

      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy";
      button.textContent = "复制";
      button.setAttribute("aria-label", "复制代码");

      let timer: ReturnType<typeof setTimeout> | undefined;
      button.addEventListener("click", async () => {
        const text = pre.innerText.replace(/\n$/, "");
        let copied = false;
        try {
          await navigator.clipboard.writeText(text);
          copied = true;
        } catch {
          try {
            const fallback = document.createElement("textarea");
            fallback.value = text;
            document.body.appendChild(fallback);
            fallback.select();
            copied = document.execCommand("copy");
            fallback.remove();
          } catch {}
        }
        button.textContent = copied ? "已复制" : "复制失败";
        clearTimeout(timer);
        timer = setTimeout(() => (button.textContent = "复制"), 1600);
      });

      wrapper.appendChild(button);
    });

    if (spyTargets.size === 0) return;

    const visible = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.isIntersecting ? visible.add(entry.target) : visible.delete(entry.target);
        }
        let current: Element | null = null;
        for (const [target] of spyTargets) {
          if (visible.has(target)) {
            current = target;
            break;
          }
        }
        spyTargets.forEach((link, target) => link.classList.toggle("is-active", target === current));
      },
      { rootMargin: "-72px 0px -68% 0px", threshold: 0 },
    );
    spyTargets.forEach((_, target) => observer.observe(target));
  }
  document.addEventListener("astro:page-load", initArticleWidgets);
  initArticleWidgets();
</script>

<style>
  /* 阅读进度条：贴在 nav 下沿的 2px 橙线；无 JS 时元素不渲染（html.js 门控） */
  .article__progress { display: none; }
  :global(html.js) .article__progress {
    display: block;
    position: fixed;
    top: calc(var(--nav-height) - 1px);
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 20;
    pointer-events: none;
  }

  /* 「屏幕外的那张纸」：内容直接落在 --bg 上，只有字，没有框 */
  .article {
    margin: 0 auto var(--space-3xl);
    position: relative;
  }
  .article__header { max-width: calc(var(--maxw-prose) + 2 * var(--page-gutter)); padding-top: 56px; padding-bottom: 40px; }
  /* 返回按钮：与 .back-home 同一制式 —— 无边框 [ … ]，hover 整行染琥珀 */
  .back-link { display: inline-flex; align-items: center; gap: 6px; margin-bottom: var(--space-xl); padding: 4px 2px; color: var(--text-faint); font-family: var(--mono); font-size: 12px; transition: color var(--dur-fast) var(--ease-out); }
  .back-link::before, .back-link::after { content: none; }
  .back-link span, .article__eyebrow { color: var(--accent); }
  .back-link span { display: inline-block; transition: transform var(--dur-base) var(--ease-out); }
  .back-link:hover, .back-link:hover::before, .back-link:hover::after { color: var(--accent); }
  .back-link:hover span { transform: translateX(-3px); }
  .article__eyebrow { margin-bottom: var(--space-lg); font-family: var(--mono); font-size: 13px; }
  /* 标题回到原来的栈：拉丁 Fraunces + 中文华文中宋衬线 */
  h1 { font-family: var(--font-display); font-size: 44px; font-weight: 600; line-height: 1.25; overflow-wrap: anywhere; }
  .article__summary { margin-top: var(--space-lg); color: var(--text-muted); font-size: 18px; line-height: 1.8; }
  .article__meta { display: flex; flex-wrap: wrap; gap: var(--space-md); margin-top: var(--space-xl); color: var(--text-faint); font-family: var(--mono); font-size: 12px; }
  .article__meta span + span::before { content: "/"; margin-right: var(--space-md); color: var(--border-strong); }
  .article__cover img { width: 100%; height: auto; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); object-fit: contain; }
  .article__layout { position: relative; max-width: calc(var(--maxw-prose) + 2 * var(--page-gutter)); padding-top: 32px; }
  .article__toc { position: absolute; left: calc(100% + 8px); top: 32px; bottom: 0; width: 176px; font-family: var(--font-body); font-size: 13px; }
  .article__toc-disclosure { position: sticky; top: calc(var(--nav-height) + 32px); max-height: calc(100dvh - var(--nav-height) - 64px); overflow-y: auto; padding-left: 16px; border-left: 1px solid var(--border); }
  .article__toc summary { color: var(--text); font-weight: 500; cursor: pointer; min-height: 44px; display: flex; align-items: center; gap: 8px; }
  .article__toc summary::before { content: '+'; color: var(--text-muted); }
  .article__toc details[open] summary::before { content: '−'; }
  .article__toc ol { display: grid; gap: var(--space-sm); margin: var(--space-md) 0 0; padding: 0; list-style: none; }
  .article__toc a { display: block; padding: 5px 0; color: var(--text-muted); line-height: 1.6; overflow-wrap: anywhere; transition: color var(--dur-fast) var(--ease-out); }
  .article__toc a:hover { color: var(--accent); }
  /* 激活项：变橙 + 左侧 2px accent 竖线（box-shadow 不占布局，无位移） */
  .article__toc a.is-active { color: var(--accent); box-shadow: -2px 0 0 var(--accent); }
  .article__toc-item--nested { padding-left: var(--space-sm); }
  .article__content {
    min-width: 0;
    padding-bottom: var(--space-4xl);
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.9;
    letter-spacing: 0;
    overflow-wrap: anywhere;
    color: var(--text);
  }
  .article__pagination { max-width: calc(var(--maxw-prose) + 2 * var(--page-gutter)); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xl); padding-top: var(--space-xl); padding-bottom: var(--space-2xl); border-top: 1px solid var(--border); overflow-wrap: anywhere; }
  .article__pagination a { display: grid; gap: var(--space-sm); color: var(--text-muted); }
  .article__pagination a:hover strong { color: var(--accent); }
  .article__pagination span { color: var(--text-faint); font-family: var(--mono); font-size: 11.5px; }
  .article__pagination strong { font-size: 1.05rem; font-weight: 500; transition: color var(--dur-fast) var(--ease-out); }
  .article__pagination a { transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  @media (hover: hover) {
    .article__pagination a:hover { transform: translateY(-2px); }
  }
  .article__pagination-next { text-align: right; border-left: 1px solid var(--border-subtle); padding-left: var(--space-xl); }
  :global(.article__content > :first-child) { margin-top: 0; }
  :global(.article__content h2) { margin-top: 56px; font-family: var(--font-body); font-size: 28px; font-weight: 600; line-height: 1.4; scroll-margin-top: calc(var(--nav-height) + var(--space-lg)); }
  :global(.article__content h3) { margin-top: 40px; font-family: var(--font-body); font-size: 22px; font-weight: 600; line-height: 1.45; scroll-margin-top: calc(var(--nav-height) + var(--space-lg)); }
  :global(.article__content p), :global(.article__content ul), :global(.article__content ol) { margin-top: var(--space-lg); }
  :global(.article__content li + li) { margin-top: var(--space-sm); }
  :global(.article__content a) { color: var(--accent); text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent); text-underline-offset: 3px; }
  :global(.article__content blockquote) { margin: var(--space-xl) 0 0; border-left: 2px solid var(--accent); padding-left: var(--space-lg); color: var(--text-muted); }
  :global(.article__content pre) { margin-top: var(--space-xl); border: 1px solid var(--border-strong); border-radius: var(--radius-sm); padding: var(--space-lg); overflow-x: auto; background: var(--code-bg); font-family: var(--mono); font-size: 13px; line-height: 1.7; }
  /* 保险：html:lang(zh-CN) 会把正文染成 Google Sans；Shiki 用 span 高亮代码，
     这些 span 也可能被命中。直接把 mono 钉在 pre 的所有后代上。 */
  :global(.article__content pre),
  :global(.article__content pre code),
  :global(.article__content pre span) { font-family: var(--mono) !important; }
  :global(.article__content pre code) { font-size: inherit; background: none; border: 0; padding: 0; }
  :global(.article__content .astro-code) { background: var(--code-bg); color: var(--shiki-dark); }
  :global(.article__content .astro-code span) { color: var(--shiki-dark); }
  :global(html[data-theme='light'] .article__content .astro-code),
  :global(html[data-theme='light'] .article__content .astro-code span) { color: var(--shiki-light); }
  :global(.article__content table) { display: block; width: 100%; overflow-x: auto; border-collapse: collapse; font-size: 15px; margin-block: 24px; }
  :global(.article__content th), :global(.article__content td) { padding: 12px 16px; border-bottom: 1px solid var(--border); text-align: left; min-width: 100px; }
  :global(.article__content th) { background: var(--surface-2); font-weight: 600; }
  :global(.article__content code) { font-family: var(--mono); }
  :global(.article__content :not(pre) > code) { border: 1px solid var(--border); border-radius: 4px; padding: 1px 5px; background: var(--accent-soft); font-size: 0.88em; }
  /* 数学公式：KaTeX 输出与正文同色；块级公式随正文列宽溢出时横向滚动，
     不撑破 720px 栅格；中文正文 1.7 行高下基线略下沉，微调对齐 */
  :global(.article__content .katex) { color: var(--text); font-size: 1.06em; }
  :global(.article__content .katex-display) { margin: var(--space-xl) 0; overflow-x: auto; overflow-y: hidden; padding: 2px 0; }
  :global(.article__content .katex-display > .katex) { font-size: 1.15em; }
  :global(.article__content .katex-error) { color: var(--accent-deep); }
  :global(.article__content img) { width: 100%; height: auto; margin-top: var(--space-xl); border: 1px solid var(--border); border-radius: var(--radius-sm); object-fit: contain; }
  :global(.article__content hr) { margin: var(--space-3xl) 0; border: 0; }
  :global(.codeblock) { position: relative; }
  /* 顶部语言条：JS 包装时把语言名写进 data-lang，这里直接读取渲染 */
  :global(.codeblock pre) { padding-top: 48px; }
  :global(.codeblock::before) {
    content: attr(data-lang);
    position: absolute;
    top: 15px;
    left: var(--space-lg);
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0;
    color: var(--text-faint);
  }
  :global(.code-copy) {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 8px;
    background: none;
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 11px;
    cursor: pointer;
    opacity: 1;
    min-height: 36px;
    transition: opacity var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  :global(.codeblock:hover .code-copy) { opacity: 1; }
  :global(.code-copy:hover), :global(.code-copy:focus-visible) { color: var(--accent); border-color: var(--border-strong); opacity: 1; }
  @media (max-width: 1279px) {
    .article__toc { position: static; width: auto; margin-bottom: 32px; border-block: 1px solid var(--border); }
    .article__toc-disclosure { position: static; border: 0; padding: 8px 0; max-height: 320px; }
    .article__toc ol { margin-top: 8px; padding-bottom: 16px; }
    .article__toc a { padding-block: 10px; }
  }
  @media (max-width: 640px) {
    .article__header { padding-top: 32px; padding-bottom: 24px; }
    h1 { font-size: 32px; }
    .article__summary { font-size: 17px; }
    .article__content { font-size: 17px; line-height: 1.85; padding-bottom: 48px; }
    :global(.article__content h2) { font-size: 25px; }
    :global(.article__content pre) { padding-inline: 16px; }
  }
  @media (max-width: 520px) {
    .article__pagination { grid-template-columns: 1fr; }
    .article__pagination-next { text-align: left; border-left: 0; padding-left: 0; }
    .article__toc ol { grid-template-columns: 1fr; }
  }
</style>
