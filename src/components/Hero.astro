---
import { ArrowRight } from '@lucide/astro';
import { dotDate, isoDate } from '../lib/format';
import FlickerTitle from './FlickerTitle.astro';
interface Props { notesCount: number; projectsCount: number; latestDate?: Date; }
const { notesCount, projectsCount, latestDate } = Astro.props;
---

<header class="intro">
  <div class="intro__content container">
  <a href="/about" class="intro__portrait" aria-label="关于 Aloha">
    <img src="https://github.com/A1oha666.png?size=128" data-github-avatar alt="Aloha 的头像" width="56" height="56" fetchpriority="high" referrerpolicy="no-referrer" />
  </a>
  <h1><span data-scramble>Aloha.</span></h1>
  <p class="intro__tagline"><span class="hero__line">Explore and build.<FlickerTitle /><span class="intro__cursor" aria-hidden="true">_</span></span></p>
  <p class="intro__description" lang="zh-CN" data-reveal>记录一些想法与实践。</p>
  <div class="intro__actions" data-reveal style="--reveal-delay: 120ms">
    <a class="intro__link intro__link--primary" href="/about">关于我 <ArrowRight size={16} aria-hidden="true" /></a>
  </div>
  </div>
  <div class="intro__meta container" aria-label="站点统计">
    <a href="/archive">{notesCount} 篇记录</a>
    <span aria-hidden="true">·</span>
    <a href="#projects">{projectsCount} 个项目</a>
    {latestDate && <><span aria-hidden="true">·</span><span>更新于 <time datetime={isoDate(latestDate)}>{dotDate(latestDate)}</time></span></>}
  </div>
</header>

<script>
  function setupAvatar() {
    const image = document.querySelector<HTMLImageElement>('[data-github-avatar]');
    if (!image || image.dataset.bound) return;
    image.dataset.bound = 'true';
    const fallback = () => { image.src = '/avatar.png'; };
    if (image.complete && image.naturalWidth === 0) fallback();
    else image.addEventListener('error', fallback, { once: true });
  }
  document.addEventListener('astro:page-load', setupAvatar);
  setupAvatar();
</script>

<style>
  .intro { display: grid; grid-template-rows: minmax(min-content, 1fr) auto; min-height: calc(100svh - var(--nav-height) - 80px); background: var(--surface-2); text-align: center; }
  .intro__content { align-self: center; padding-block: 56px; }
  .intro__portrait { display: block; width: 56px; height: 56px; margin: 0 auto 16px; border-radius: 50%; transition: transform 400ms var(--ease-out); }
  .intro__portrait:hover { transform: scale(1.07); }
  .intro__portrait img { border-radius: 50%; object-fit: cover; }
  h1 { font-family: var(--font-display); font-size: 76px; font-weight: 650; line-height: 1.05; }
  .intro__tagline { margin-top: 12px; font-size: 28px; font-weight: 500; line-height: 1.4; }
  .hero__line { position: relative; display: inline-block; }
  .intro__cursor { position: absolute; left: 100%; color: var(--accent); animation: cursor-blink 1.6s steps(1) infinite; }
  :global(html[data-theme='light']) .hero__line :global(.fk-ch) { filter: none !important; opacity: clamp(0.08, var(--fk, 1), 1); }
  .intro__description { margin-top: 8px; font-size: 18px; color: var(--text-muted); }
  .intro__actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px 24px; margin-top: 24px; }
  .intro__link { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; color: var(--accent); font-size: 15px; }
  .intro__link--primary { padding: 0 22px; border-radius: 24px; background: var(--accent); color: var(--on-accent); transition: background 200ms ease; }
  .intro__link--primary:hover { background: var(--accent-deep); }
  .intro__link:not(.intro__link--primary):hover { text-decoration: underline; text-underline-offset: 4px; }
  .intro__link :global(svg) { transition: transform 250ms var(--ease-out); }
  .intro__link:hover :global(svg) { transform: translateX(3px); }
  .intro__meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 4px 12px; padding-block: 12px 24px; color: var(--text-muted); font-size: 12px; font-variant-numeric: tabular-nums; }
  .intro__meta a { display: inline-flex; align-items: center; min-height: 32px; }
  .intro__meta a:hover { color: var(--accent); }
  @media (max-width: 640px) {
    .intro__content { padding-block: 40px; }
    h1 { font-size: 56px; }
    .intro__tagline { font-size: 23px; }
    .intro__description { font-size: 16px; }
    .intro__meta { gap: 2px 8px; font-size: 11px; padding-bottom: 16px; }
  }
  @media (max-height: 700px) {
    .intro__content { padding-block: 20px; }
    .intro__portrait { width: 48px; height: 48px; margin-bottom: 12px; }
    .intro__portrait img { width: 48px; height: 48px; }
    h1 { font-size: 56px; }
    .intro__tagline { font-size: 23px; }
    .intro__description { font-size: 16px; }
    .intro__actions { margin-top: 20px; }
    .intro__meta { padding-block: 8px 12px; }
  }
</style>
