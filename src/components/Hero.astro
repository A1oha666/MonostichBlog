---
import LogStream from "./LogStream.astro";
import FlickerTitle from "./FlickerTitle.astro";

interface PathWeight {
  p: string;
  w: number;
}
interface Props {
  logPaths?: PathWeight[];
}
const { logPaths = [] } = Astro.props;
---

<header class="hero">
  <LogStream paths={logPaths} />
  <div class="hero__colophon container">
    <p>
      <span class="hero__prompt">aloha@monostich</span><span class="hero__sep">:</span><span class="hero__path">~</span><span class="hero__dollar">$</span>
    </p>
    <p><span class="hero__led" aria-hidden="true"></span>monostich.cloud</p>
  </div>
  <div class="hero__inner container">
    <h1 class="hero__title">
      <span class="hero__line" style="--line-index: 0">explore and build.<FlickerTitle /><span class="hero__cursor" aria-hidden="true">_</span></span>
    </h1>
    <p class="hero__intro" lang="zh-CN" style="--line-index: 1">记录一些想法与实践。</p>
  </div>
</header>

<style>
  .hero {
    min-height: 88vh;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  /* 日志瀑布 canvas 沉在最底层，文字内容抬到其上 */
  .hero__colophon,
  .hero__inner {
    position: relative;
    z-index: 1;
  }

  /* 顶部 colophon：一行 shell 提示符 + 域名，像终端的第一行 */
  .hero__colophon {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-xl);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--text-faint);
  }
  .hero__prompt { color: var(--text-muted); }
  .hero__sep { color: var(--text-faint); }
  .hero__path { color: var(--text-muted); }
  /* 全页仅有的两处磷光之一：提示符的 $ */
  .hero__dollar { color: var(--accent); margin-left: 8px; }

  /* 状态灯：一粒琥珀 LED，硬闪烁 —— 机器活着的信号 */
  .hero__led {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent-glow), 0 0 14px var(--accent-glow);
    animation: led-blink 2.1s steps(1) infinite;
  }
  @keyframes led-blink {
    0%, 64% { opacity: 1; }
    65%, 100% { opacity: 0.12; }
  }

  /* 文字压到视口下三分之一：上方的大片空无即是神秘 */
  .hero__inner {
    margin-top: auto;
    padding-bottom: 13vh;
  }

  .hero__title {
    font-family: var(--mono);
    font-weight: 500;
    font-size: clamp(2.3rem, 6vw, 4.9rem);
    letter-spacing: -0.02em;
    line-height: 1.18;
    /* 磷光余晖，不纯白；亮色主题由 token 回落正文色 */
    color: var(--hero-title);
  }

  .hero__line { display: block; }

  /* 全页仅有的两处磷光之二：句尾硬闪烁下划线光标 */
  .hero__cursor {
    color: var(--accent);
    margin-left: 0.08em;
    animation: cursor-blink 1.6s steps(1) infinite;
  }

  /* 副题是一行代码注释 */
  .hero__intro {
    margin-top: var(--space-xl);
    color: var(--text-muted);
    font-size: 1.02rem;
  }
  .hero__intro::before {
    content: "//";
    font-family: var(--mono);
    color: var(--text-faint);
  }

  /* 进场只有慢速的模糊消散，无位移、无色散；
     全局 reduced-motion 规则会兜底关掉所有动画。
     有 JS 时灯管闪烁（FlickerTitle）接管 .hero__line 的进场 */
  .hero__intro {
    animation: hero-in 1400ms var(--ease-out) both;
    animation-delay: calc(160ms + var(--line-index, 0) * 260ms);
  }
  html:not(.js) .hero__line {
    animation: hero-in 1400ms var(--ease-out) both;
    animation-delay: 160ms;
  }

  @keyframes hero-in {
    from { opacity: 0; filter: blur(10px); }
    to { opacity: 1; filter: blur(0); }
  }

  @media (max-width: 600px) {
    .hero { min-height: 82vh; }
    .hero__inner { padding-bottom: 10vh; }
    .hero__title { font-size: clamp(1.7rem, 8.6vw, 2.6rem); }
  }
</style>
