---
import LogStream from "./LogStream.astro";
import HeroGlow from "./HeroGlow.astro";
import FlickerTitle from "./FlickerTitle.astro";

interface PathWeight {
  p: string;
  w: number;
}
interface Props {
  logPaths?: PathWeight[];
  notesCount?: string;
  projectsCount?: string;
  updatedLabel?: string;
}
const {
  logPaths = [],
  notesCount = "05",
  projectsCount = "08",
  updatedLabel = "09.05",
} = Astro.props;
---

<header class="hero">
  <HeroGlow />
  <LogStream paths={logPaths} />
  <div class="hero__colophon container">
    <p>
      <span class="hero__prompt">aloha@monostich</span><span class="hero__sep">:</span><span class="hero__path">~</span><span class="hero__dollar">$</span>
    </p>
  </div>
  <div class="hero__layout container">
    <div class="hero__inner">
      <p class="hero__eyebrow">// blog & notes</p>
      <h1 class="hero__title">
        <span class="hero__line" style="--line-index: 0">explore<br />and build.<FlickerTitle /><span class="hero__cursor" aria-hidden="true">_</span></span>
      </h1>
      <p class="hero__intro" lang="zh-CN" style="--line-index: 1">记录一些想法与实践。</p>
    </div>
    <aside class="hero__status" aria-label="Site status">
      <p class="hero__status-label">monostich.cloud</p>
      <p class="hero__status-state"><span class="hero__led" aria-hidden="true"></span>online</p>
      <dl><div><dt>notes</dt><dd>{notesCount}</dd></div><div><dt>projects</dt><dd>{projectsCount}</dd></div><div><dt>updated</dt><dd>{updatedLabel}</dd></div></dl>
    </aside>
  </div>
</header>

<style>
  .hero {
    /* Hero 专属版心：spec §4 要求 1200px / 5vw gutter，不动全局 token */
    --maxw: 1200px;
    --page-gutter: clamp(20px, 5vw, 64px);
    min-height: min(820px, 88vh);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: clip;
    isolation: isolate;
  }
  @supports not (overflow: clip) {
    .hero { overflow: hidden; }
  }

  /* 日志瀑布 canvas 沉在最底层，文字内容抬到其上 */
  .hero__colophon,
  .hero__layout {
    position: relative;
    z-index: 1;
  }

  /* 顶部 colophon：只剩一行 shell 提示符；online 状态由状态卡单独负责 */
  .hero__colophon {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: 32px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--text-faint);
  }
  .hero__prompt { color: var(--text-muted); }
  .hero__sep { color: var(--text-faint); }
  .hero__path { color: var(--text-muted); }
  /* 全页仅有的两处磷光之一：提示符的 $ */
  .hero__dollar { color: var(--accent); margin-left: 8px; }

  /* 状态灯：一粒琥珀 LED，硬闪烁 —— 机器活着的信号 */
  .hero__led {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 6px var(--accent-glow), 0 0 14px var(--accent-glow);
    animation: led-blink 2.1s steps(1) infinite;
  }
  @keyframes led-blink {
    0%, 64% { opacity: 1; }
    65%, 100% { opacity: 0.12; }
  }

  /* 主内容与状态卡同一 grid 行、底部对齐 —— 共享一条基线，
     不再是两个互不相干的模块 */
  .hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    align-items: end;
    gap: 80px;
    margin-top: auto;
    padding-bottom: 10vh;
  }

  .hero__inner { position: relative; z-index: 2; }

  /* 内容保护区：标题/说明/CTA 背后垫一层由实到虚的底色，
     背景日志与辉光不许进入阅读路径 */
  .hero__inner::before {
    content: "";
    position: absolute;
    inset: -24px -40px;
    z-index: -1;
    background: linear-gradient(
      90deg,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 88%, transparent) 55%,
      transparent 100%
    );
  }

  .hero__eyebrow { margin-bottom: var(--space-lg); color: var(--accent); font-family: var(--mono); font-size: 12px; letter-spacing: 0.04em; }

  .hero__title {
    max-width: 560px;
    font-family: var(--mono);
    font-weight: 500;
    /* 从海报尺度回落到可阅读的编辑尺度：两行正好放下 */
    font-size: clamp(3rem, 5.6vw, 5.2rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
    /* 磷光余晖，不纯白；亮色主题由 token 回落正文色 */
    color: var(--hero-title);
  }

  .hero__line { display: block; }

  /* 全页仅有的两处磷光之二：句尾硬闪烁下划线光标 */
  .hero__cursor {
    color: var(--accent);
    /* FlickerTitle 的空壳组件后会保留一个折叠空白，收回它让光标紧贴 build. */
    margin-left: -0.54em;
    animation: cursor-blink 1.6s steps(1) infinite;
  }

  /* 中文介绍：衬线、克制，与标题保持一个紧凑间距 */
  .hero__intro {
    margin-top: 24px;
    color: var(--text);
    max-width: 25ch;
    font-family: var(--serif-zh);
    font-size: 18px;
    line-height: 1.7;
  }

  /* 状态卡：足够的纸面感 —— 边框更明确，底色更接近 surface */
  .hero__status {
    width: 210px;
    padding: 18px;
    border: 1px solid var(--border-strong);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
  }
  .hero__status-label { color: var(--text-muted); margin-bottom: 14px; }
  .hero__status-state { color: var(--accent); margin-bottom: 18px; }
  .hero__status .hero__led { width: 6px; height: 6px; margin-right: 7px; }
  .hero__status dl { margin: 0; }
  .hero__status dl div { display: flex; justify-content: space-between; padding-top: 8px; border-top: 1px solid var(--border-subtle); }
  .hero__status dt, .hero__status dd { margin: 0; }
  .hero__status dd { color: var(--text-muted); }

  /* 进场只有慢速的模糊消散，无位移、无色散；
     全局 reduced-motion 规则会兜底关掉所有动画。
     有 JS 时灯管闪烁（FlickerTitle）接管 .hero__line 的进场；
     视图过渡下 html.js 可能丢失，所以用组件打上的 class 让位 */
  .hero__intro {
    animation: hero-in 1400ms var(--ease-out) both;
    animation-delay: calc(160ms + var(--line-index, 0) * 260ms);
  }
  html:not(.js) .hero__line:not(.hero__line--flicker) {
    animation: hero-in 1400ms var(--ease-out) both;
    animation-delay: 160ms;
  }

  @keyframes hero-in {
    from { opacity: 0; filter: blur(10px); }
    to { opacity: 1; filter: blur(0); }
  }

  /* 601–1100px：状态卡收窄、间距收紧，仍与标题同行并置 */
  @media (max-width: 1100px) and (min-width: 601px) {
    .hero__layout { grid-template-columns: minmax(0, 1fr) 180px; gap: 48px; }
    .hero__status { width: 180px; padding: 14px; }
  }

  @media (max-width: 600px) {
    .hero { min-height: 82vh; }
    .hero__layout { grid-template-columns: 1fr; gap: 40px; padding-bottom: 8vh; align-items: start; }
    /* 10 个字符的 "and build._" 按 0.62em 均宽 + 负字距测算：
       11vw @375px ≈ 41px，两行恰好放下且不破词 */
    .hero__title { font-size: clamp(1.9rem, 11vw, 3.2rem); }
    .hero__actions a { display: inline-flex; align-items: center; min-height: 44px; }
    .hero__status { width: auto; padding: 12px 14px; }
    .hero__status-label, .hero__status-state { display: inline; margin: 0 18px 0 0; }
    .hero__status dl { display: inline-flex; gap: 14px; }
    .hero__status dl div { border: 0; padding: 0; gap: 4px; }
  }

  /* ≤420px：CTA 纵向排列，状态条缩写为 notes 05 · projects 08 · 09.05 */
  @media (max-width: 420px) {
    .hero__actions { flex-direction: column; gap: 4px; }
    .hero__status dl div:last-child dt { display: none; }
  }
</style>
