<header class="intro">
  <div class="intro__content container">
  <a href="/about" class="intro__portrait" aria-label="关于 Aloha">
    <img src="https://github.com/A1oha666.png?size=128" data-github-avatar alt="Aloha 的头像" width="56" height="56" fetchpriority="high" referrerpolicy="no-referrer" />
  </a>
  <h1><span data-scramble>Aloha.</span></h1>
  <p class="intro__description" lang="zh-CN" data-reveal>记录一些想法与实践。</p>
  </div>
</header>

<script>
  function setupAvatar() {
    const image = document.querySelector<HTMLImageElement>('[data-github-avatar]');
    if (!image || image.dataset.bound) return;
    image.dataset.bound = 'true';
    const fallback = () => { image.src = '/avatar.png'; };
    if (image.complete && image.naturalWidth === 0) fallback();
    else image.addEventListener('error', fallback, { once: true });
  }
  document.addEventListener('astro:page-load', setupAvatar);
  setupAvatar();
</script>

<style>
  .intro { display: grid; min-height: calc(100svh - var(--nav-height)); background: var(--surface-2); text-align: center; }
  .intro__content { align-self: center; padding-block: 56px; }
  .intro__portrait { display: block; width: 56px; height: 56px; margin: 0 auto 16px; border-radius: 50%; transition: transform 400ms var(--ease-out); }
  .intro__portrait:hover { transform: scale(1.07); }
  .intro__portrait img { border-radius: 50%; object-fit: cover; }
  h1 { font-family: var(--font-display); font-size: 76px; font-weight: 650; line-height: 1.05; }
  .intro__description { margin-top: 16px; font-size: 18px; color: var(--text-muted); }
  @media (max-width: 640px) {
    .intro__content { padding-block: 40px; }
    h1 { font-size: 56px; }
    .intro__description { font-size: 16px; }
  }
  @media (max-height: 700px) {
    .intro__content { padding-block: 20px; }
    .intro__portrait { width: 48px; height: 48px; margin-bottom: 12px; }
    .intro__portrait img { width: 48px; height: 48px; }
    h1 { font-size: 56px; }
    .intro__description { font-size: 16px; }
  }
</style>
