---
const year = new Date().getFullYear();
---

<footer class="footer container">
  <p>© {year} Aloha</p>
  <div>
    <a href="https://github.com/A1oha666" target="_blank" rel="noopener">GitHub ↗<span class="sr-only">（在新窗口打开）</span></a>
    <a href="/rss.xml">RSS</a>
    <a href="mailto:292081295@qq.com">Email</a>
    <a href="https://admin.monostich.cloud/_/" title="内容后台">管理</a>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-top: var(--space-4xl);
    padding-top: var(--space-lg);
    padding-bottom: var(--space-2xl);
    border-top: 1px solid var(--border-subtle);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-faint);
  }
  .footer div { display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-lg); }
  /* :lang(zh-CN) 直接命中链接元素，mono 不能只靠 .footer 的继承 */
  .footer a { color: var(--text-faint); font-family: var(--mono); transition: color var(--dur-fast) var(--ease-out); }
  .footer a:hover { color: var(--accent); }
</style>
