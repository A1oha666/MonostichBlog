---
import { projects } from "../data/projects.js";
---

<section class="section container" id="projects" aria-labelledby="work-heading">
  <div class="module-head" data-reveal>
    <h2 id="work-heading" data-scramble>项目</h2>
  </div>

  <ol class="work-list" id="project-list" aria-label="项目列表">
    {
      projects.map((project, index) => {
        // 尚无公开仓库（repo 为 "#"）时渲染静态行，避免假链接
        const linked = project.repo && project.repo !== "#";
        const reveal = `--reveal-delay: ${Math.min(index * 60, 180)}ms`;
        const inner = (
          <>
            <span class="work-row__name">{project.name}</span>
            <span class="work-row__desc">{project.desc}</span>
            <span class:list={["work-row__status", { "work-row__status--live": project.status === "active" }]}>
              {project.status === 'active' ? '可使用' : project.status === 'developing' ? '开发中' : project.status === 'archived' ? '已归档' : project.status}
            </span>
          </>
        );
        return (
          <li data-reveal style={reveal}>
            {linked ? (
              <a class="work-row" href={project.repo} target="_blank" rel="noopener">
                {inner}
              </a>
            ) : (
              <div class="work-row work-row--static">{inner}</div>
            )}
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  /* .module-head / .section 样式在 global.css 统一维护 */

  /* ===== 造物：无卡片，三栏一行 —— 名 / 述 / 状态 ===== */
  .work-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    max-width: 100%;
    margin: 0 auto;
    padding: 8px 0 16px;
    list-style: none;
    text-align: center;
  }
  .work-list > li {
    border-right: 1px solid var(--border);
    min-width: 0;
  }
  .work-list > li:last-child { border-right: 0; }
  .work-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    height: 100%;
    padding: 20px;
  }
  .work-row__name {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    color: var(--text);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .work-row__desc {
    max-width: 30ch;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.6;
    white-space: normal;
  }
  .work-row__status {
    margin-top: auto;
    padding-top: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0;
    color: var(--text-faint);
    white-space: nowrap;
  }
  /* 可使用的项目：不点灯、不描边，只换一点磷光 */
  .work-row__status--live { color: var(--accent); }

  .work-row--static { cursor: default; }
  @media (hover: hover) {
    a.work-row:hover .work-row__name { color: var(--accent); }
  }
  a.work-row:focus-visible .work-row__name { color: var(--accent); }

  @media (max-width: 700px) {
    .work-list {
      grid-template-columns: 1fr;
      padding-block: 0;
    }
    .work-list > li {
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    .work-list > li:last-child { border-bottom: 0; }
    .work-row {
      gap: 8px;
      padding: 20px 8px;
    }
  }
</style>
