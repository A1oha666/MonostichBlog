---
import { projects } from "../data/projects.js";
const visibleProjects = projects.slice(0, 2);
---

<section class="section container" id="projects">
  <div class="section__head" data-reveal>
    <h2>Selected work</h2>
    <a href="https://github.com/" target="_blank" rel="noopener">GitHub →</a>
  </div>

  <div class="work-list">
    {
      visibleProjects.map((project, index) => (
        <article class="work" data-reveal style={`--reveal-delay: ${Math.min(index * 60, 240)}ms`}>
          <div>
            <h3>{project.name}</h3>
            <p>{project.desc}</p>
          </div>
          <p class="work__stack">{project.tags.slice(0, 2).join(" / ")}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .section { padding-block: var(--space-4xl); scroll-margin-top: calc(var(--nav-height) + var(--space-lg)); }
  .section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border-strong);
  }
  .section__head h2 {
    font-size: 1rem;
    font-family: var(--mono);
    font-weight: 500;
  }
  .section__head a {
    color: var(--text-muted);
    font-family: var(--mono);
    font-size: 12.5px;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .section__head a:hover { color: var(--accent); }
  .work {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-xl);
    padding-inline: var(--space-sm);
    margin-inline: calc(-1 * var(--space-sm));
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--border);
    transition: background var(--dur-fast) var(--ease-out), border-radius var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) {
    .work:hover { background: color-mix(in srgb, var(--accent) 4%, transparent); }
  }
  .work h3 {
    font-family: var(--mono);
    font-size: 1rem;
    font-weight: 500;
    color: var(--accent);
  }
  .work p {
    max-width: 62ch;
    margin-top: var(--space-sm);
    color: var(--text-muted);
    font-size: 0.98rem;
  }
  .work .work__stack {
    margin: 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-faint);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .section { padding-block: var(--space-3xl); }
    .work { grid-template-columns: 1fr; gap: var(--space-md); }
  }
</style>
