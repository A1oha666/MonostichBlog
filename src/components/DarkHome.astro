---
import Hero from "./DarkHero.astro";
import Projects from "./DarkProjects.astro";
import { dotDate, isoDate, safeDate } from "../lib/format";
import { getBlogCollections, momentTitle } from "../lib/content";
import { lab } from "../data/lab.js";
import { projects } from "../data/projects.js";

interface Props { collections: Awaited<ReturnType<typeof getBlogCollections>>; }
const { notes, thinkings, moments } = Astro.props.collections;

// 「一行」：最新一条小记，作为本站点题的单行诗
const latestMoment = moments
  .map((entry) => ({
    id: entry.id,
    date: safeDate(entry.data.date),
    text: momentTitle(entry),
  }))
  .filter((m) => m.text)
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())[0];

// 首页展示最近五篇（Notes 与 Thinkings 含小记混排），完整回溯走 /archive。
// 已被「一行」引用的小记从目录里剔除，避免相邻两节重复同一条内容。
const recent = [
  ...notes.map((entry) => ({
    key: `notes/${entry.id}`,
    date: safeDate(entry.data.date),
    title: entry.data.title,
    href: `/notes/${entry.id}/`,
  })),
  ...thinkings.map((entry) => ({
    key: `thinkings/${entry.id}`,
    date: safeDate(entry.data.date),
    title: entry.data.title,
    href: `/thinkings/${entry.id}/`,
  })),
  ...moments.map((entry) => ({
    key: `moments/${entry.id}`,
    date: safeDate(entry.data.date),
    title: momentTitle(entry),
    href: `/thinkings#${entry.id}`,
  })),
]
  .filter((item) => item.key !== `moments/${latestMoment?.id}`)
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 5);

// Hero 状态面板：真实统计（notes 数 / projects 数 / 最近更新时间）
const allEntries = [...notes, ...thinkings, ...moments];
const notesCount = allEntries.length;
const projectsCount = projects.length;
const latestDate = allEntries
  .map((entry) => safeDate(entry.data.date))
  .sort((a, b) => b.valueOf() - a.valueOf())[0];
const pad2 = (n) => String(n).padStart(2, "0");
const updatedLabel = latestDate
  ? `${pad2(latestDate.getMonth() + 1)}.${pad2(latestDate.getDate())}`
  : "—";

// Hero 日志瀑布的路径池：真实 slug + 访问权重，文章页权重高于索引页。
// 新增文章自动入池，无需手维护。
const logPaths = [
  { p: "/", w: 10 },
  ...notes.map((entry) => ({ p: `/notes/${entry.id}`, w: 6 })),
  ...thinkings.map((entry) => ({ p: `/thinkings/${entry.id}`, w: 5 })),
  { p: "/notes", w: 3 },
  { p: "/thinkings", w: 3 },
  { p: "/archive", w: 2 },
  { p: "/about", w: 2 },
  { p: "/rss.xml", w: 1.5 },
];
---

<div class="theme-home theme-home--dark">
  <Hero
    logPaths={logPaths}
    notesCount={pad2(notesCount)}
    projectsCount={pad2(projectsCount)}
    updatedLabel={updatedLabel}
  />

  {
    latestMoment && (
      <section class="oneline container" aria-labelledby="dark-oneline-heading">
        <div class="module-head">
          <h2 id="dark-oneline-heading"><span class="module-head__no">01</span> 随想</h2>
          <a href="/thinkings">小记 →</a>
        </div>
        <figure class="oneline__figure" data-reveal style="--reveal-delay: 80ms">
          <blockquote lang="zh-CN">{latestMoment.text}</blockquote>
          <figcaption>
            <time datetime={isoDate(latestMoment.date)}>{dotDate(latestMoment.date)}</time>
          </figcaption>
        </figure>
      </section>
    )
  }

  <section class="section container" id="recent-dark" aria-labelledby="dark-recent-heading">
    <div class="module-head" data-reveal>
      <h2 id="dark-recent-heading"><span class="module-head__no">02</span> 文章</h2>
      <a href="/archive">全部 →</a>
    </div>
    <!-- 列表内容以中文为主：局部标注语言，避免 html lang 影响英文 Hero 的字体选择 -->
    <ol class="recent-list" lang="zh-CN">
      {
        recent.map((item, index) => (
          <li data-reveal style={`--reveal-delay: ${Math.min(index * 60, 240)}ms`}>
            <a href={item.href}>
              <span class="recent-list__no" aria-hidden="true">{index + 1}</span>
              <span class="recent-list__title">{item.title}</span>
              <time datetime={isoDate(item.date)}>{dotDate(item.date)}</time>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <Projects />

  <section class="section container" aria-labelledby="dark-lab-heading">
    <div class="module-head" data-reveal>
      <h2 id="dark-lab-heading"><span class="module-head__no">04</span> 实验室</h2>
      <a href="/lab/">全部 →</a>
    </div>
    <ol class="recent-list" lang="zh-CN">
      {
        lab.map((item, index) => (
          <li data-reveal style={`--reveal-delay: ${Math.min(index * 60, 120)}ms`}>
            <a href={item.href}>
              <span class="recent-list__no" aria-hidden="true">{index + 1}</span>
              <span class="recent-list__title">{item.name}</span>
              <span class="recent-list__desc">{item.desc}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

</div>

<style>
  /* .module-head / .section 样式在 global.css 统一维护 */

  /* ===== 一行：markdown 引用式 —— > 开头的一行，周围留白即是装裱 ===== */
  .oneline { padding-block: var(--space-2xl) var(--space-2xl); }
  .oneline__figure { margin: 0; }
  .oneline__figure blockquote {
    position: relative;
    margin: 0;
    padding-left: 1.2em;
    max-width: 26ch;
    font-size: 32px;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0;
    color: var(--text);
  }
  .oneline__figure blockquote::before {
    content: ">";
    position: absolute;
    left: 0;
    font-family: var(--mono);
    color: var(--accent-dim);
  }
  .oneline__figure figcaption {
    margin-top: var(--space-lg);
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* ===== 目录：编辑器 gutter 式 —— 右对齐行号 + 竖线 + 题名 + 日期 ===== */
  .recent-list { margin: 0; padding: 0; list-style: none; }
  .recent-list > li { border-bottom: 1px solid var(--border-subtle); }
  .recent-list a {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 20px;
    padding-block: 22px;
  }
  .recent-list__no {
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 18px;
    border-right: 1px solid var(--border-subtle);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-base) var(--ease-out);
  }
  .recent-list time {
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-base) var(--ease-out);
  }
  .recent-list__title {
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    text-overflow: ellipsis;
    white-space: normal;
    font-family: 'Google Sans', var(--font-zh);
    font-size: 1.12rem;
    font-weight: 400;
    line-height: 1.5;
    transition: color var(--dur-fast) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  /* 交互只动三处：编号染朱、题名微移、日期提亮 —— 没有底色块 */
  .recent-list > li:focus-within .recent-list__no,
  .recent-list a:hover .recent-list__no { color: var(--accent); }
  .recent-list a:focus-visible .recent-list__title,
  .recent-list a:hover .recent-list__title { transform: translateX(6px); }
  .recent-list a:hover time { color: var(--text-muted); }

  .recent-list__desc {
    color: var(--text-faint);
    font-family: var(--mono);
    font-size: 11.5px;
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--dur-base) var(--ease-out);
  }
  .recent-list a:hover .recent-list__desc { color: var(--text-muted); }

  @media (max-width: 640px) {
    .recent-list a { grid-template-columns: 40px minmax(0, 1fr); row-gap: 6px; padding-block: 16px; }
    .recent-list__no { padding-right: 12px; }
    .recent-list time { grid-column: 2; }
    .recent-list__desc { grid-column: 2; text-align: left; white-space: normal; }
  }
</style>
