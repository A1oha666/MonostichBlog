---
// 当前页判断：SSR 侧用 Astro.url.pathname 输出 aria-current；
// transition:persist 让 nav 跨页面导航不重挂载，因此客户端导航后
// 由下方脚本按 location.pathname 重新同步，避免高亮滞留。
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (base: string) => pathname === base || pathname.startsWith(`${base}/`);
---

<nav class="nav" aria-label="Primary" transition:persist="nav">
  <div class="nav__inner container">
    <a class="nav__brand" href="/">Aloha.</a>
    <div class="nav__links">
      <a href="/archive" data-nav-base="/archive" aria-current={isActive("/archive") ? "page" : undefined}>Archive</a>
      <a href="/notes" data-nav-base="/notes" aria-current={isActive("/notes") ? "page" : undefined}>Notes</a>
      <a href="/thinkings" data-nav-base="/thinkings" aria-current={isActive("/thinkings") ? "page" : undefined}>Thinkings</a>
      <a href="/#projects">Work</a>
      <a href="/about" data-nav-base="/about" aria-current={isActive("/about") ? "page" : undefined}>About</a>
      <button
        class="nav__theme"
        id="theme-toggle"
        type="button"
        aria-label="Toggle light / dark theme"
        title="Toggle theme"
      >
        <svg class="ic ic--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="ic ic--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  // Re-bound on astro:page-load so the handler survives view-transition swaps.
  function bindThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn || btn.dataset.themeBound) return;
    btn.dataset.themeBound = "true";
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch {}
    });
  }

  // nav 被 transition:persist 保留，SSR 写入的 aria-current 不会随页面
  // 换新；这里在每次客户端导航后按当前路径重算（Work 锚点链接除外）。
  function syncCurrentPage() {
    const path = location.pathname.replace(/\/$/, "") || "/";
    document.querySelectorAll<HTMLAnchorElement>(".nav__links a[data-nav-base]").forEach((a) => {
      const base = a.dataset.navBase ?? "";
      const active = base !== "" && (path === base || path.startsWith(`${base}/`));
      if (active) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
  }

  document.addEventListener("astro:page-load", () => {
    bindThemeToggle();
    syncCurrentPage();
  });
  bindThemeToggle();
  syncCurrentPage();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--nav-bg);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .nav__inner {
    /* 与样例一致：品牌与链接都收进 1080px container，不做全宽铺开 */
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: calc(var(--nav-height) - 1px);
    font-family: var(--mono);
    font-size: 13px;
  }
  .nav__brand { color: var(--accent); font-weight: 700; }
  .nav__links { display: flex; align-items: center; gap: 26px; }
  @media (max-width: 520px) {
    .nav__links {
      gap: var(--space-md);
      font-size: 12px;
      /* 链接 + 搜索入口放不进窄屏单行：允许内部横向滑动；
         min-width:0 解除 flex 子项的 min-content 撑宽，溢出才不会顶破视口 */
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--space-md));
      padding-inline: var(--space-md);
    }
    .nav__links::-webkit-scrollbar { display: none; }
  }
  .nav__links a {
    position: relative;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) {
    .nav__links a:hover { color: var(--accent); }
    .nav__links a:hover::after { transform: scaleX(1); }
  }
  /* 当前页常驻态：下划线常驻、颜色提亮 */
  .nav__links a[aria-current="page"] { color: var(--text); }
  .nav__links a[aria-current="page"]::after { transform: scaleX(1); }

  .nav__theme {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .nav__theme:hover { color: var(--accent); border-color: var(--accent); }
  .nav__theme:active { transform: scale(0.92); }
  /* extend the tap area to ~44px without enlarging the visible control */
  .nav__theme::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
  }
  .ic {
    position: absolute;
    width: 14px;
    height: 14px;
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .ic--sun { opacity: 1; transform: none; }
  .ic--moon { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  :global(html[data-theme="light"]) .ic--moon { opacity: 1; transform: none; }
  :global(html[data-theme="light"]) .ic--sun { opacity: 0; transform: rotate(90deg) scale(0.6); }
</style>
