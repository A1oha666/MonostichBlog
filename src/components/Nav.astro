---
// 当前页判断：SSR 侧用 Astro.url.pathname 输出 aria-current；
// transition:persist 让 nav 跨页面导航不重挂载，因此客户端导航后
// 由下方脚本按 location.pathname 重新同步，避免高亮滞留。
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (base: string) => pathname === base || pathname.startsWith(`${base}/`);
---

<nav class="nav" aria-label="Primary" transition:persist="nav">
    <div class="nav__inner container">
      <a class="nav__brand" href="/">Aloha.</a>
      <div class="nav__links">
        <a href="/archive" data-nav-base="/archive" aria-current={isActive("/archive") ? "page" : undefined}>Archive</a>
        <a href="/notes" data-nav-base="/notes" aria-current={isActive("/notes") ? "page" : undefined}>Notes</a>
        <a href="/thinkings" data-nav-base="/thinkings" aria-current={isActive("/thinkings") ? "page" : undefined}>Thinkings</a>
        <a href="/#projects">Work</a>
        <a href="/lab" data-nav-base="/lab" aria-current={isActive("/lab") ? "page" : undefined}>Lab</a>
        <a href="/about" data-nav-base="/about" aria-current={isActive("/about") ? "page" : undefined}>About</a>
      </div>
      <button
        class="nav__icon"
        id="search-open"
        type="button"
        aria-label="搜索"
        title="搜索"
      >
        <svg class="nav__icon-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>
      <button
        class="nav__icon nav__theme"
        id="theme-toggle"
        type="button"
        aria-label="Switch to light theme"
        title="Toggle theme"
      >
        <svg class="nav__icon-svg ic ic--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="nav__icon-svg ic ic--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </div>
</nav>

<script>
  // Re-bound on astro:page-load so the handler survives view-transition swaps.
  function bindThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn || btn.dataset.themeBound) return;
    btn.dataset.themeBound = "true";
    // SSR 文案按默认深色输出；本地存储为浅色时（BaseLayout 的 head 内联
    // 脚本执行时按钮尚未存在）在这里同步一次按钮名称
    if (document.documentElement.dataset.theme === "light") {
      btn.setAttribute("aria-label", "Switch to dark theme");
    }
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch {}
      // 与 BaseLayout 的 applyTheme 保持一致：按钮名称反映下一步动作，
      // 浅色主题下移动浏览器 UI 也跟着换色
      btn.setAttribute("aria-label", next === "light" ? "Switch to dark theme" : "Switch to light theme");
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", next === "dark" ? "#101216" : "#f4f3ee");
    });
  }

  // nav 被 transition:persist 保留，SSR 写入的 aria-current 不会随页面
  // 换新；这里在每次客户端导航后按当前路径重算（Work 锚点链接除外）。
  function syncCurrentPage() {
    const path = location.pathname.replace(/\/$/, "") || "/";
    document.querySelectorAll<HTMLAnchorElement>(".nav__links a[data-nav-base]").forEach((a) => {
      const base = a.dataset.navBase ?? "";
      const active = base !== "" && (path === base || path.startsWith(`${base}/`));
      if (active) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
  }

  // 搜索入口：已在搜索页则聚焦输入框，否则跳转 /search
  function bindSearchOpen() {
    const btn = document.getElementById("search-open");
    if (!btn || btn.dataset.searchBound) return;
    btn.dataset.searchBound = "true";
    btn.addEventListener("click", () => {
      if (location.pathname.replace(/\/$/, "") === "/search") {
        document.querySelector<HTMLInputElement>(".pagefind-ui__search-input")?.focus();
      } else {
        location.href = "/search/";
      }
    });
  }

  document.addEventListener("astro:page-load", () => {
    bindThemeToggle();
    bindSearchOpen();
    syncCurrentPage();
  });
  bindThemeToggle();
  bindSearchOpen();
  syncCurrentPage();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--nav-bg);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .nav__inner {
    /* 与样例一致：品牌与链接都收进 1080px container，不做全宽铺开。
       gap 保证链接区与主题按钮之间保持原设计 26px 间距
       （宽屏下 margin-left:auto 吸收品牌侧空间，窄屏下 gap 是最小间隔） */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 26px;
    min-height: calc(var(--nav-height) - 1px);
    font-family: var(--mono);
    font-size: 13px;
  }
  .nav__brand { color: var(--accent); font-weight: 700; /* 显式声明：zh-CN 页面的 :lang 规则会直接命中元素，靠继承拿不到 mono */ font-family: var(--mono); }
  /* 链接区用 margin-left:auto 靠向主题按钮。不要用 justify-content:
     flex-end —— 它与横向溢出组合会把左端条目挤出可滚动范围（flexbox
     的 start-edge 数据丢失问题） */
  .nav__links {
    display: flex;
    min-width: 0;
    margin-left: auto;
    align-items: center;
    gap: 26px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav__links::-webkit-scrollbar { display: none; }
  @media (max-width: 520px) {
    .nav__links {
      gap: var(--space-md);
      font-size: 12px;
      /* 链接放不进窄屏单行：允许内部横向滑动（滚动能力已在基础样式声明）；
         margin-inline 负值让滑动区域延伸到视口边缘 */
      margin-inline: calc(-1 * var(--space-md));
      padding-inline: var(--space-md);
      /* 两侧渐隐暗示该区域可横向滑动（内容两侧有 16px padding，
         静止时渐隐只落在留白上，不裁切首尾链接） */
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 14px, #000 calc(100% - 14px), transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 14px, #000 calc(100% - 14px), transparent 100%);
    }
  }
  .nav__links a {
    position: relative;
    color: var(--text-muted);
    /* :lang(zh-CN) 会直接命中链接元素，mono 必须在此显式声明而非依赖继承 */
    font-family: var(--mono);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -8px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) {
    .nav__links a:hover { color: var(--accent); }
    .nav__links a:hover::after { transform: scaleX(1); }
  }
  /* 当前页常驻态：下划线常驻、颜色提亮 */
  .nav__links a[aria-current="page"] { color: var(--text); }
  .nav__links a[aria-current="page"]::after { transform: scaleX(1); }

  .nav__icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .nav__icon:hover { color: var(--accent); }
  .nav__icon:active { transform: scale(0.92); }
  /* extend the tap area to ~44px without enlarging the visible control */
  .nav__icon::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
  }
  .nav__icon-svg { width: 14px; height: 14px; }
  .nav__theme .nav__icon-svg {
    position: absolute;
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .ic--sun { opacity: 1; transform: none; }
  .ic--moon { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  :global(html[data-theme="light"]) .ic--moon { opacity: 1; transform: none; }
  :global(html[data-theme="light"]) .ic--sun { opacity: 0; transform: rotate(90deg) scale(0.6); }
</style>
