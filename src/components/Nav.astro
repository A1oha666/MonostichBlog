---
---

<nav class="nav" aria-label="Primary" transition:persist="nav">
  <div class="nav__inner container">
    <a class="nav__brand" href="/">Aloha.</a>
    <div class="nav__links">
      <a href="/archive">Archive</a>
      <a href="/notes">Notes</a>
      <a href="/thinkings">Thinkings</a>
      <a href="/#projects">Work</a>
      <button
        class="nav__theme"
        id="theme-toggle"
        type="button"
        aria-label="Toggle light / dark theme"
        title="Toggle theme"
      >
        <svg class="ic ic--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="ic ic--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  // Re-bound on astro:page-load so the handler survives view-transition swaps.
  function bindThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn || btn.dataset.themeBound) return;
    btn.dataset.themeBound = "true";
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const next = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch {}
    });
  }
  document.addEventListener("astro:page-load", bindThemeToggle);
  bindThemeToggle();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid var(--border);
    background: var(--nav-bg);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .nav__inner {
    max-width: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: calc(var(--nav-height) - 1px);
    font-family: var(--mono);
    font-size: 13px;
  }
  .nav__brand { color: var(--accent); font-weight: 700; }
  .nav__links { display: flex; align-items: center; gap: var(--space-lg); }
  @media (max-width: 520px) {
    .nav__links {
      gap: var(--space-md);
      font-size: 12px;
      /* 6 个链接放不进窄屏单行：允许内部横向滑动；
         min-width:0 解除 flex 子项的 min-content 撑宽，溢出才不会顶破视口 */
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--space-md));
      padding-inline: var(--space-md);
    }
    .nav__links::-webkit-scrollbar { display: none; }
  }
  .nav__links a {
    position: relative;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) {
    .nav__links a:hover { color: var(--accent); }
    .nav__links a:hover::after { transform: scaleX(1); }
  }
  .nav__theme {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .nav__theme:hover { color: var(--accent); border-color: var(--accent); }
  .nav__theme:active { transform: scale(0.92); }
  /* extend the tap area to ~44px without enlarging the visible control */
  .nav__theme::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: 50%;
  }
  .ic {
    position: absolute;
    width: 14px;
    height: 14px;
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .ic--sun { opacity: 1; transform: none; }
  .ic--moon { opacity: 0; transform: rotate(-90deg) scale(0.6); }
  :global(html[data-theme="light"]) .ic--moon { opacity: 1; transform: none; }
  :global(html[data-theme="light"]) .ic--sun { opacity: 0; transform: rotate(90deg) scale(0.6); }
</style>
