---
import { Sun, Moon, Menu, X, Search, ArrowUpRight } from '@lucide/astro';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/notes', label: '笔记', darkLabel: 'Notes', base: '/notes' },
  { href: '/thinkings', label: '随想', darkLabel: 'Thinkings', base: '/thinkings' },
  { href: '/archive', label: '归档', darkLabel: 'Archive', base: '/archive' },
  { href: '/#projects', label: '项目', darkLabel: 'Work' },
  { href: '/lab', label: '实验室', darkLabel: 'Lab', base: '/lab' },
  { href: '/about', label: '关于', darkLabel: 'About', base: '/about' },
];
---
<nav class="nav" aria-label="主导航" transition:persist="nav">
  <div class="nav__inner container">
    <a class="nav__brand" href="/">Aloha.</a>
    <div class="nav__links" id="primary-links">
      {links.map((link, index) => (
        <a href={link.href} style={`--menu-index: ${index}`} data-nav-base={link.base} data-project-link={!link.base || undefined} aria-current={link.base && (pathname === link.base || pathname.startsWith(`${link.base}/`)) ? 'page' : undefined}><span class="nav__label-light">{link.label}</span><span class="nav__label-dark">{link.darkLabel}</span><ArrowUpRight class="nav__link-arrow" size={20} aria-hidden="true" /></a>
      ))}
    </div>
    <div class="nav__tools">
      <a class="nav__search" href="/archive/?search=1" aria-label="搜索文章" title="搜索文章"><Search size={17} aria-hidden="true" /></a>
      <button class="nav__theme" id="theme-toggle" type="button" aria-label="切换主题" title="切换主题">
        <Sun class="ic--sun" size={18} aria-hidden="true" />
        <Moon class="ic--moon" size={18} aria-hidden="true" />
      </button>
      <button class="nav__menu" id="menu-toggle" type="button" aria-label="打开导航" aria-expanded="false" aria-controls="primary-links" title="打开导航">
        <Menu class="ic--menu" size={21} aria-hidden="true" />
        <X class="ic--close" size={21} aria-hidden="true" />
      </button>
    </div>
  </div>
</nav>

<script>
  let scrollQueued = false;
  function syncNavSize() {
    const root = document.documentElement;
    // Hysteresis avoids repeated transitions near the scroll threshold.
    if (window.scrollY > 80) root.setAttribute('data-nav-compact', '');
    else if (window.scrollY < 24) root.removeAttribute('data-nav-compact');
  }
  window.addEventListener('scroll', () => {
    if (scrollQueued) return;
    scrollQueued = true;
    requestAnimationFrame(() => { scrollQueued = false; syncNavSize(); });
  }, { passive: true });

  function setupNav() {
    syncNavSize();
    const nav = document.querySelector<HTMLElement>('.nav');
    const theme = document.getElementById('theme-toggle');
    const menu = document.getElementById('menu-toggle');
    if (!nav || !theme || !menu) return;
    const closeMenu = () => {
      nav.removeAttribute('data-open');
      document.documentElement.removeAttribute('data-menu-open');
      if (window.matchMedia('(max-width: 700px)').matches) nav.querySelector<HTMLElement>('.nav__links')?.setAttribute('inert', '');
      menu.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-label', '打开导航');
      menu.title = '打开导航';
    };
    const syncTheme = (restoreAnchor = true) => {
      const dark = document.documentElement.dataset.theme === 'dark';
      const label = dark ? '切换到浅色主题' : '切换到深色主题';
      theme.setAttribute('aria-label', label);
      theme.title = label;
      nav.querySelector('[data-project-link]')?.setAttribute('href', dark ? '/#projects-dark' : '/#projects');
      if (restoreAnchor && location.pathname === '/' && ['#projects', '#projects-dark'].includes(location.hash)) {
        const hash = dark ? '#projects-dark' : '#projects';
        if (location.hash !== hash) history.replaceState(history.state, '', hash);
        requestAnimationFrame(() => document.querySelector(hash)?.scrollIntoView({ behavior: 'instant' }));
      }
    };
    closeMenu();
    if (window.matchMedia('(min-width: 701px)').matches) nav.querySelector('.nav__links')?.removeAttribute('inert');
    syncTheme();
    const path = location.pathname.replace(/\/$/, '') || '/';
    nav.querySelectorAll<HTMLAnchorElement>('a[data-nav-base]').forEach((link) => {
      const base = link.dataset.navBase ?? '';
      if (base && (path === base || path.startsWith(`${base}/`))) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
    if (nav.dataset.bound) return;
    nav.dataset.bound = 'true';
    theme.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#101216' : '#ffffff');
      syncTheme(false);
      if (document.body.classList.contains('home')) {
        if (location.hash) history.replaceState(history.state, '', location.pathname + location.search);
        window.scrollTo({ top: 0, behavior: 'instant' });
      }
      document.dispatchEvent(new Event('themechange'));
    });
    menu.addEventListener('click', () => {
      if (nav.hasAttribute('data-open')) return closeMenu();
      nav.setAttribute('data-open', '');
      document.documentElement.setAttribute('data-menu-open', '');
      nav.querySelector('.nav__links')?.removeAttribute('inert');
      menu.setAttribute('aria-expanded', 'true');
      menu.setAttribute('aria-label', '关闭导航');
      menu.title = '关闭导航';
    });
    nav.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) closeMenu();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.hasAttribute('data-open')) { closeMenu(); menu.focus(); }
      if (event.key === 'Tab' && nav.hasAttribute('data-open')) {
        const focusable = [...nav.querySelectorAll<HTMLElement>('a, button')].filter(el => el.getClientRects().length > 0);
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      }
    });
    document.addEventListener('click', (event) => {
      if (!nav.contains(event.target as Node)) closeMenu();
    });
    window.matchMedia('(min-width: 701px)').addEventListener('change', (event) => {
      closeMenu();
      if (event.matches) nav.querySelector('.nav__links')?.removeAttribute('inert');
    });
  }
  document.addEventListener('astro:page-load', setupNav);
  setupNav();
</script>

<style>
  .nav__label-dark { display: none; }
  :global(html[data-theme='dark']) .nav__label-dark { display: inline; }
  :global(html[data-theme='dark']) .nav__label-light { display: none; }
  .nav { position: fixed; top: 8px; left: 0; right: 0; z-index: 30; pointer-events: none; }
  .nav__inner { display: flex; align-items: center; gap: 24px; width: calc(100% - 48px); max-width: 1140px; min-height: 48px; padding-inline: 16px; margin-inline: auto; border: 1px solid transparent; border-radius: 100px; pointer-events: auto; transition: max-width 480ms cubic-bezier(0.22, 1, 0.36, 1), width 480ms cubic-bezier(0.22, 1, 0.36, 1), background-color 300ms ease, border-color 300ms ease, box-shadow 300ms ease; }
  :global(html[data-nav-compact]) .nav__inner { max-width: 980px; background: color-mix(in srgb, var(--bg) 72%, transparent); border-color: var(--border); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); box-shadow: 0 2px 12px rgb(0 0 0 / 3%); }
  .nav__brand { font: 650 21px var(--font-body); color: var(--text); flex: 0 0 88px; padding-left: 0; transition: padding-left 480ms cubic-bezier(0.22, 1, 0.36, 1); }
  :global(html[data-nav-compact]) .nav__brand { padding-left: 12px; }
  .nav__links { display: flex; flex: 1; justify-content: center; align-items: center; gap: 32px; margin-left: auto; }
  :global(.nav__link-arrow) { display: none; }
  .nav__links a { display: flex; align-items: center; min-height: 44px; font: 13px var(--font-body); color: var(--text-muted); white-space: nowrap; }
  .nav__links a:hover, .nav__links a[aria-current='page'] { color: var(--accent); }
  .nav__links a[aria-current='page'] { text-decoration: underline; text-underline-offset: 7px; }
  .nav__tools { display: flex; flex: 0 0 auto; }
  button, .nav__search { display: grid; place-items: center; width: 44px; height: 44px; border: 0; padding: 0; background: none; color: var(--text-muted); cursor: pointer; transition: color 200ms ease; }
  button:hover, .nav__search:hover { color: var(--text); }
  button :global(svg) { grid-area: 1 / 1; }
  .nav__menu, :global(.ic--moon), :global(.ic--close) { display: none; }
  :global(html[data-theme='light']) :global(.ic--moon) { display: block; }
  :global(html[data-theme='light']) :global(.ic--sun) { display: none; }
  @media (max-width: 700px) {
    .nav__brand { flex-basis: 80px; }
    :global(html[data-nav-compact]) .nav__brand { padding-left: 6px; }
    .nav__inner { justify-content: space-between; gap: 8px; width: calc(100% - 48px); padding-inline: 12px; }
    .nav__menu { display: grid; }
    .nav__links { display: flex; flex-direction: column; align-items: stretch; justify-content: start; gap: 0; visibility: hidden; pointer-events: none; position: absolute; top: 56px; left: 0; right: 0; height: calc(100dvh - 64px); overflow-y: auto; padding: 24px 40px 48px; background: var(--bg); margin: 0; clip-path: inset(0 0 100%); transition: clip-path 420ms cubic-bezier(0.22, 1, 0.36, 1), visibility 420ms; }
    .nav__links a { justify-content: space-between; min-height: 60px; font-size: 28px; font-weight: 600; color: var(--text); opacity: 0; transform: translateY(-10px); transition: opacity 150ms ease, transform 150ms ease; }
    .nav[data-open]::before { content: ''; position: absolute; inset: -8px 0 0; background: var(--bg); z-index: -1; }
    .nav[data-open] .nav__inner { background: var(--bg); border-color: transparent; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; }
    .nav[data-open] .nav__links { visibility: visible; pointer-events: auto; clip-path: inset(0); }
    .nav[data-open] .nav__links a { opacity: 1; transform: none; transition: opacity 360ms ease, transform 360ms var(--ease-out); transition-delay: calc(70ms + var(--menu-index) * 30ms); }
    :global(.nav__link-arrow) { display: block; color: var(--text-faint); }
    .nav[data-open] :global(.ic--menu) { display: none; }
    .nav[data-open] :global(.ic--close) { display: block; }
    :global(html:not(.js)) .nav__inner { flex-wrap: wrap; }
    :global(html:not(.js)) .nav { position: static; }
    :global(html:not(.js)) .nav__links { display: flex; flex-direction: row; flex-wrap: wrap; visibility: visible; pointer-events: auto; clip-path: none; height: auto; position: static; order: 3; flex-basis: 100%; padding: 0 0 12px; gap: 0 24px; }
    :global(html:not(.js)) .nav__links a { opacity: 1; transform: none; font-size: 16px; }
    :global(html:not(.js)) :global(.nav__link-arrow) { display: none; }
    :global(html:not(.js)) .nav__tools { display: none; }
  }
</style>
